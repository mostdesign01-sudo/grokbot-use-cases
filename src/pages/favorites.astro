---
import AgentUiCard from "../components/AgentUiCard.astro";
import CaseCard from "../components/CaseCard.astro";
import HtmlCard from "../components/HtmlCard.astro";
import Loc from "../components/Loc.astro";
import ModelCard from "../components/ModelCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { agentUiItems } from "../lib/agent-ui";
import { cases } from "../lib/cases";
import { htmlItems } from "../lib/html";
import { ui } from "../lib/i18n";
import { listModels } from "../lib/models";
import { withBase } from "../lib/paths";
import { favKey } from "../lib/stars";

/**
 * Static GitHub Pages: no account, no server. Every item is rendered hidden and
 * the favorites script in BaseLayout reveals the ones saved in localStorage.
 */
const models = listModels();
---

<BaseLayout
  collection="lab"
  title={ui.fav.title.zh}
  titleEn={ui.fav.title.en}
  description={ui.fav.desc.zh}
  descriptionEn={ui.fav.desc.en}
>
  <div class="wrap-wide">
    <section class="collection-hero">
      <p class="kicker">Favorites</p>
      <h1><Loc zh={ui.fav.mine.zh} en={ui.fav.mine.en} /></h1>
      <p class="lede"><Loc zh={ui.fav.lede.zh} en={ui.fav.lede.en} /></p>
      <p class="meta-line"><Loc zh={ui.fav.local.zh} en={ui.fav.local.en} /></p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("search/")}><Loc zh={ui.fav.browse.zh} en={ui.fav.browse.en} /></a>
        <button
          class="btn btn-ghost"
          type="button"
          data-fav-clear
          data-confirm-zh={ui.fav.clearConfirm.zh}
          data-confirm-en={ui.fav.clearConfirm.en}
          hidden
        >
          <Loc zh={ui.fav.clear.zh} en={ui.fav.clear.en} />
        </button>
      </div>
    </section>

    <div class="search-page" data-fav-page>
      <p class="count-row" data-fav-total data-count-zh={ui.fav.count.zh} data-count-en={ui.fav.count.en} hidden></p>
      <p class="empty" data-fav-empty hidden>
        <Loc zh={ui.fav.empty.zh} en={ui.fav.empty.en} />
      </p>
      <noscript>
        <p class="empty">
          <span class="loc-zh">收藏需要开启 JavaScript（只读本机 localStorage）。</span>
          <span class="loc-en">Favorites need JavaScript (they read this browser’s localStorage).</span>
        </p>
      </noscript>

      <div class="fav-groups">
        <section class="fav-group" data-fav-group hidden>
          <h2>Grok Bot</h2>
          <div class="tweet-feed">
            {
              cases.map((item) => (
                <div class="item" data-fav-item={favKey("grok", item.id)} hidden>
                  <CaseCard caseItem={item} />
                </div>
              ))
            }
          </div>
        </section>

        <section class="fav-group" data-fav-group hidden>
          <h2><Loc zh={ui.lib.html.zh} en={ui.lib.html.en} /></h2>
          <div class="masonry">
            {
              htmlItems.map((item) => (
                <div class="item" data-fav-item={favKey("html", item.id)} hidden>
                  <HtmlCard item={item} />
                </div>
              ))
            }
          </div>
        </section>

        <section class="fav-group" data-fav-group hidden>
          <h2>Agent UI</h2>
          <div class="masonry">
            {
              agentUiItems.map((item) => (
                <div class="item" data-fav-item={favKey("agent-ui", item.id)} hidden>
                  <AgentUiCard item={item} />
                </div>
              ))
            }
          </div>
        </section>

        <section class="fav-group" data-fav-group hidden>
          <h2><Loc zh={ui.nav.models.zh} en={ui.nav.models.en} /></h2>
          <div class="model-grid">
            {
              models.map((model) => (
                <div class="item" data-fav-item={favKey("models", model.id)} hidden>
                  <ModelCard model={model} />
                </div>
              ))
            }
          </div>
        </section>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const page = document.querySelector<HTMLElement>("[data-fav-page]");
  const total = page?.querySelector<HTMLElement>("[data-fav-total]");
  const empty = page?.querySelector<HTMLElement>("[data-fav-empty]");
  const clear = document.querySelector<HTMLButtonElement>("[data-fav-clear]");
  const groups = [...(page?.querySelectorAll<HTMLElement>("[data-fav-group]") ?? [])];

  const locale = () => (document.documentElement.dataset.locale === "en" ? "en" : "zh");

  const refresh = () => {
    let count = 0;
    for (const group of groups) {
      const shown = [...group.querySelectorAll<HTMLElement>("[data-fav-item]")].filter((item) => !item.hidden).length;
      group.hidden = shown === 0;
      count += shown;
    }
    if (total) {
      const template = total.getAttribute(locale() === "en" ? "data-count-en" : "data-count-zh") ?? "";
      total.textContent = template.replace("{n}", String(count));
      total.hidden = count === 0;
    }
    if (empty) empty.hidden = count !== 0;
    if (clear) clear.hidden = count === 0;
  };

  clear?.addEventListener("click", () => {
    const message = clear.getAttribute(locale() === "en" ? "data-confirm-en" : "data-confirm-zh") ?? "";
    if (!message || window.confirm(message)) {
      (window as Window & { __favorites?: { clear: () => void } }).__favorites?.clear();
    }
  });

  document.addEventListener("favoriteschange", refresh);
  document.addEventListener("localechange", refresh);
  refresh();
</script>

---
import { withBase, isCurrentPath, isSectionPath } from "../lib/paths";

const path = Astro.url.pathname;
const htmlRoot = withBase("html/");
const isHtml = isSectionPath(path, htmlRoot);

const grokLinks = [
  { href: withBase("/"), label: "首页" },
  { href: withBase("featured/"), label: "精选" },
  { href: withBase("latest/"), label: "最新" },
  { href: withBase("types/"), label: "类型", section: true },
  { href: withBase("cases/"), label: "案例" },
  { href: withBase("docs/"), label: "文档" },
  { href: withBase("changelog/"), label: "更新日志" },
];

const htmlLinks = [
  { href: withBase("html/"), label: "总览" },
  { href: withBase("html/featured/"), label: "精选" },
  { href: withBase("html/latest/"), label: "最新" },
  { href: withBase("html/types/"), label: "类型", section: true },
];

const links = isHtml ? htmlLinks : grokLinks;
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase("/")}>
      <span class="brand-mark">{isHtml ? "H" : "库"}</span>
      <span class="brand-text">
        <strong>{isHtml ? "HTML 收集" : "Grok Bot 案例库"}</strong>
        <span>{isHtml ? "公开网页范例 · 非官方" : "每日更新 · 非官方"}</span>
      </span>
    </a>
    <nav class="collection-tabs" aria-label="内容库">
      <a
        class="tab-grok"
        href={withBase("/")}
        aria-current={!isHtml ? "page" : undefined}
      >
        Grok Bot
      </a>
      <a
        class="tab-html"
        href={withBase("html/")}
        aria-current={isHtml ? "page" : undefined}
      >
        HTML 收集
      </a>
    </nav>
    <nav class="nav" aria-label="栏目">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={(link.section
              ? isSectionPath(path, link.href)
              : isCurrentPath(path, link.href))
              ? "page"
              : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换浅色或深色主题">
        <span aria-hidden="true">◐</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector("[data-theme-toggle]");
  button?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>

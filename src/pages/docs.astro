---
import BaseLayout from "../layouts/BaseLayout.astro";
import { docGroups, officialDocs } from "../lib/docs";
---

<BaseLayout title="文档枢纽 · AI UP LAB" description="Grok Bot 与 Cursor Automations 官方链接。">
  <div class="wrap">
    <p class="kicker">Docs</p>
    <h1>文档枢纽</h1>
    <p class="lede">
      下列均为官方或产品文档链接。本站只做导航与对照，不替代原文档。
    </p>

    {
      docGroups.map((group) => (
        <section class="section">
          <div class="section-head">
            <div>
              <h2>{group.title}</h2>
              <p>{group.blurb}</p>
            </div>
          </div>
          <div class="doc-grid">
            {officialDocs
              .filter((item) => item.group === group.id)
              .map((item) => (
                <a class="card" href={item.href} rel="noreferrer">
                  <h3>{item.title}</h3>
                  <p class="summary">{item.description}</p>
                  <p class="title-en">{item.href}</p>
                </a>
              ))}
          </div>
        </section>
      ))
    }
  </div>
</BaseLayout>

---
import AgentUiCard from "../components/AgentUiCard.astro";
import CaseCard from "../components/CaseCard.astro";
import HtmlCard from "../components/HtmlCard.astro";
import LibrarySearch from "../components/LibrarySearch.astro";
import Loc from "../components/Loc.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { agentUiItems, agentUiSearchText } from "../lib/agent-ui";
import { agentUiTypeLabel } from "../lib/agent-ui-labels";
import { caseSearchText, cases } from "../lib/cases";
import { htmlItems, htmlSearchText } from "../lib/html";
import { htmlTypeLabel } from "../lib/html-labels";
import { ui } from "../lib/i18n";
import { categoryLabel, difficultyLabel, sourceBadgeLabel } from "../lib/labels";
---

<BaseLayout
  collection="lab"
  title={ui.pages.searchTitle.zh}
  titleEn={ui.pages.searchTitle.en}
  description={ui.pages.searchDesc.zh}
  descriptionEn={ui.pages.searchDesc.en}
>
  <div class="wrap-wide">
    <section class="collection-hero">
      <p class="kicker">Search</p>
      <h1><Loc zh={ui.pages.searchH1.zh} en={ui.pages.searchH1.en} /></h1>
      <p class="lede">
        <span class="loc-zh">
          在当前页面筛选 <code>cases.json</code>、<code>html-items.json</code> 与 <code>agent-ui.json</code>。不会混写成一套新闻流，只检索已收录的可复用条目。
        </span>
        <span class="loc-en">
          Filter <code>cases.json</code>, <code>html-items.json</code>, and <code>agent-ui.json</code> on this page. Not a mixed news feed — only listed reusable items.
        </span>
      </p>
      <LibrarySearch library="all" liveFilter={false} />
    </section>

    <div class="search-page" data-search-page>
      <div class="search-tabs" role="tablist" aria-label={ui.search.scope.zh} data-aria-zh={ui.search.scope.zh} data-aria-en={ui.search.scope.en}>
        <button type="button" class="search-tab" data-lib="all" aria-selected="true"><Loc zh={ui.lib.all.zh} en={ui.lib.all.en} /></button>
        <button type="button" class="search-tab" data-lib="grok" aria-selected="false">Grok Bot</button>
        <button type="button" class="search-tab" data-lib="html" aria-selected="false"><Loc zh={ui.lib.html.zh} en={ui.lib.html.en} /></button>
        <button type="button" class="search-tab" data-lib="agent-ui" aria-selected="false">Agent UI</button>
      </div>
      <p class="count-row" data-count data-count-all-zh={ui.search.countAll.zh} data-count-all-en={ui.search.countAll.en} data-count-one-zh={ui.search.countOne.zh} data-count-one-en={ui.search.countOne.en}></p>
      <div class="search-results" data-results>
        <div class="tweet-feed" data-grok-results>
          {
            cases.map((item) => (
              <div
                class="item"
                data-item
                data-lib="grok"
                data-text={`${caseSearchText(item)} ${item.categories.map((cat) => categoryLabel(cat)).join(" ")} ${item.categories.map((cat) => categoryLabel(cat, "en")).join(" ")} ${sourceBadgeLabel(item.sourceType)} ${sourceBadgeLabel(item.sourceType, "en")} ${difficultyLabel(item.difficulty)} ${difficultyLabel(item.difficulty, "en")}`}
              >
                <CaseCard caseItem={item} />
              </div>
            ))
          }
        </div>
        <div class="masonry" data-visual-results>
          {
            htmlItems.map((item) => (
              <div class="item" data-item data-lib="html" data-text={`${htmlSearchText(item)} ${item.types.map((type) => htmlTypeLabel(type)).join(" ")} ${item.types.map((type) => htmlTypeLabel(type, "en")).join(" ")}`}>
                <HtmlCard item={item} />
              </div>
            ))
          }
          {
            agentUiItems.map((item) => (
              <div class="item" data-item data-lib="agent-ui" data-text={`${agentUiSearchText(item)} ${item.types.map((type) => agentUiTypeLabel(type)).join(" ")} ${item.types.map((type) => agentUiTypeLabel(type, "en")).join(" ")}`}>
                <AgentUiCard item={item} />
              </div>
            ))
          }
        </div>
      </div>
      <p class="empty" hidden data-empty><Loc zh={ui.search.empty.zh} en={ui.search.empty.en} /></p>
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector("[data-search-page]");
  const form = document.querySelector<HTMLFormElement>(".library-search");
  const input = form?.querySelector<HTMLInputElement>("input[name='q']");
  if (root && form && input) {
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const count = root.querySelector("[data-count]");
    const empty = root.querySelector("[data-empty]");
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-lib]")];
    const params = new URLSearchParams(location.search);
    const allowed = new Set(["grok", "html", "agent-ui"]);
    let lib = allowed.has(params.get("lib") ?? "") ? params.get("lib")! : "all";

    if (params.get("q")) input.value = params.get("q") ?? "";

    const syncUrl = () => {
      const next = new URLSearchParams();
      const query = input.value.trim();
      if (query) next.set("q", query);
      if (lib !== "all") next.set("lib", lib);
      const qs = next.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    };

    const apply = () => {
      const query = input.value.trim().toLowerCase();
      let visible = 0;
      let grokVisible = 0;
      let htmlVisible = 0;
      let agentVisible = 0;

      for (const item of items) {
        const text = (item.dataset.text ?? "").toLowerCase();
        const matchLib = lib === "all" || item.dataset.lib === lib;
        const matchQuery = !query || text.includes(query);
        const match = matchLib && matchQuery;
        item.hidden = !match;
        if (match) {
          visible += 1;
          if (item.dataset.lib === "grok") grokVisible += 1;
          else if (item.dataset.lib === "html") htmlVisible += 1;
          else agentVisible += 1;
        }
      }

      for (const tab of tabs) {
        tab.setAttribute("aria-selected", tab.dataset.lib === lib ? "true" : "false");
      }

      if (count) {
        const locale = document.documentElement.dataset.locale === "en" ? "en" : "zh";
        const tpl =
          lib === "all"
            ? count.getAttribute(locale === "en" ? "data-count-all-en" : "data-count-all-zh") ?? ""
            : count.getAttribute(locale === "en" ? "data-count-one-en" : "data-count-one-zh") ?? "";
        count.textContent = tpl
          .replace("{n}", String(visible))
          .replace("{grok}", String(grokVisible))
          .replace("{html}", String(htmlVisible))
          .replace("{agent}", String(agentVisible));
      }
      if (empty) empty.toggleAttribute("hidden", visible !== 0);
      const grokBox = root.querySelector<HTMLElement>("[data-grok-results]");
      const visualBox = root.querySelector<HTMLElement>("[data-visual-results]");
      if (grokBox) grokBox.hidden = grokVisible === 0;
      if (visualBox) visualBox.hidden = htmlVisible + agentVisible === 0;
      syncUrl();
    };

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        lib = tab.dataset.lib ?? "all";
        apply();
      });
    }

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      apply();
    });
    input.addEventListener("input", apply);
    document.addEventListener("localechange", apply);
    apply();
  }
</script>

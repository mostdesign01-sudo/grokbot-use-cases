---
import Loc from "./Loc.astro";
import type { DigestDay } from "../lib/digest";
import { ui } from "../lib/i18n";
import { withBase } from "../lib/paths";

interface Props {
  day: DigestDay;
}

const { day } = Astro.props;
---

<article class="plaza-card plaza-digest" data-plaza-digest>
  <header class="plaza-digest-head">
    <h1><Loc zh={ui.home.digest.zh} en={ui.home.digest.en} /></h1>
    <p class="plaza-digest-date">
      <Loc zh={day.dateLabel.zh} en={day.dateLabel.en} />
    </p>
  </header>
  {
    day.lead.zh && (
      <p class="plaza-digest-lead">
        <Loc zh={day.lead.zh} en={day.lead.en} />
      </p>
    )
  }
  {
    day.bullets.length > 0 && (
      <ul class="plaza-digest-bullets">
        {day.bullets.map((bullet) => (
          <li>
            <Loc zh={bullet.zh} en={bullet.en} />
          </li>
        ))}
      </ul>
    )
  }
  {
    day.relatedPaths.length > 0 && (
      <p class="plaza-digest-related">
        <span class="plaza-digest-related-label">
          <Loc zh={ui.home.relatedPath.zh} en={ui.home.relatedPath.en} />
        </span>
        {day.relatedPaths.map((path, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a href={withBase(`paths/${path.slug}/`)}>
              <span class="loc-zh">{path.title}</span>
              <span class="loc-en">{path.titleEn}</span>
            </a>
          </>
        ))}
      </p>
    )
  }
</article>

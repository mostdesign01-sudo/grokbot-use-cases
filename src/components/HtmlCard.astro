---
import type { HtmlItem } from "../lib/html";
import { htmlTypeLabel } from "../lib/html-labels";
import { withBase } from "../lib/paths";
import Badge from "./Badge.astro";
import QualityNote from "./QualityNote.astro";

interface Props {
  item: HtmlItem;
}

const { item } = Astro.props;
---

<article class="case-card html-card">
  <div class="badges">
    {item.featured && <Badge kind="featured" label="+ 精选" />}
    {item.types.map((type) => <Badge label={htmlTypeLabel(type)} />)}
  </div>
  <h3><a href={withBase(`html/${item.slug}/`)}>{item.title}</a></h3>
  <p class="summary">{item.summary}</p>
  <QualityNote note={item.qualityNote} />
  <div class="card-meta">
    <a class="source-out" href={item.sourceUrl} rel="noreferrer">打开原文</a>
    <span>{item.tags.slice(0, 3).join(" · ")}</span>
  </div>
</article>

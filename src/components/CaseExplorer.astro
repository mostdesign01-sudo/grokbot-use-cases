---
import type { CaseItem, Difficulty, SourceType } from "../lib/cases";
import { uniqueCategories, uniqueDifficulties, uniqueSourceTypes } from "../lib/cases";
import { ui } from "../lib/i18n";
import { categoryLabel, difficultyLabel, sourceTypeLabel } from "../lib/labels";
import CaseCard from "./CaseCard.astro";
import Loc from "./Loc.astro";

interface Props {
  cases: CaseItem[];
}

const { cases } = Astro.props;
const categories = uniqueCategories();
const sourceTypes = uniqueSourceTypes();
const difficulties = uniqueDifficulties();
---

<div class="explorer" data-explorer>
  <form class="filters" data-filters>
    <div class="filter-row">
      <label class="field">
        <Loc zh={ui.explorer.search.zh} en={ui.explorer.search.en} />
        <input
          type="search"
          name="q"
          placeholder={ui.search.explorer.zh}
          data-ph-zh={ui.search.explorer.zh}
          data-ph-en={ui.search.explorer.en}
          autocomplete="off"
        />
      </label>
      <label class="field">
        <Loc zh={ui.explorer.category.zh} en={ui.explorer.category.en} />
        <select name="category">
          <option value="" data-label-zh={ui.explorer.allCategories.zh} data-label-en={ui.explorer.allCategories.en}>
            {ui.explorer.allCategories.zh}
          </option>
          {categories.map((value) => (
            <option value={value} data-label-zh={categoryLabel(value)} data-label-en={categoryLabel(value, "en")}>
              {categoryLabel(value)}
            </option>
          ))}
        </select>
      </label>
      <label class="field">
        <Loc zh={ui.explorer.source.zh} en={ui.explorer.source.en} />
        <select name="sourceType">
          <option value="" data-label-zh={ui.explorer.allSources.zh} data-label-en={ui.explorer.allSources.en}>
            {ui.explorer.allSources.zh}
          </option>
          {sourceTypes.map((value: SourceType) => (
            <option value={value} data-label-zh={sourceTypeLabel(value)} data-label-en={sourceTypeLabel(value, "en")}>
              {sourceTypeLabel(value)}
            </option>
          ))}
        </select>
      </label>
      <label class="field">
        <Loc zh={ui.explorer.difficulty.zh} en={ui.explorer.difficulty.en} />
        <select name="difficulty">
          <option value="" data-label-zh={ui.explorer.allDifficulties.zh} data-label-en={ui.explorer.allDifficulties.en}>
            {ui.explorer.allDifficulties.zh}
          </option>
          {difficulties.map((value: Difficulty) => (
            <option value={value} data-label-zh={difficultyLabel(value)} data-label-en={difficultyLabel(value, "en")}>
              {difficultyLabel(value)}
            </option>
          ))}
        </select>
      </label>
    </div>
    <div class="filter-toggles">
      <label class="toggle">
        <input type="checkbox" name="hasRoutine" />
        <Loc zh={ui.badge.routine.zh} en={ui.badge.routine.en} />
      </label>
      <label class="toggle">
        <input type="checkbox" name="hasMultiAgent" />
        <Loc zh={ui.badge.multi.zh} en={ui.badge.multi.en} />
      </label>
      <label class="toggle">
        <input type="checkbox" name="requiresApproval" />
        <Loc zh={ui.badge.approval.zh} en={ui.badge.approval.en} />
      </label>
      <button class="reset" type="reset"><Loc zh={ui.explorer.reset.zh} en={ui.explorer.reset.en} /></button>
    </div>
  </form>

  <div class="count-row">
    <p data-count data-count-zh={ui.explorer.count.zh} data-count-en={ui.explorer.count.en}></p>
  </div>

  <div class="tweet-feed" data-grid>
    {
      cases.map((item) => (
        <div
          class="item"
          data-item
          data-categories={item.categories.join(",")}
          data-source={item.sourceType}
          data-difficulty={item.difficulty}
          data-routine={String(item.hasRoutine)}
          data-multi={String(item.hasMultiAgent)}
          data-approval={String(item.requiresApproval)}
          data-text={`${item.title} ${item.titleEn} ${item.summary} ${item.summaryEn ?? ""} ${item.qualityNote} ${item.qualityNoteEn ?? ""} ${item.role} ${item.connectors.join(" ")} ${item.categories.join(" ")} ${item.id}`}
        >
          <CaseCard caseItem={item} />
        </div>
      ))
    }
  </div>
  <p class="empty" hidden data-empty><Loc zh={ui.explorer.empty.zh} en={ui.explorer.empty.en} /></p>
</div>

<script>
  const root = document.querySelector("[data-explorer]");
  if (root) {
    const form = root.querySelector("[data-filters]") as HTMLFormElement;
    const items = [...root.querySelectorAll<HTMLElement>("[data-item]")];
    const count = root.querySelector("[data-count]");
    const empty = root.querySelector("[data-empty]");
    const total = items.length;

    const apply = () => {
      const data = new FormData(form);
      const q = String(data.get("q") ?? "").trim().toLowerCase();
      const category = String(data.get("category") ?? "");
      const sourceType = String(data.get("sourceType") ?? "");
      const difficulty = String(data.get("difficulty") ?? "");
      const hasRoutine = form.hasRoutine.checked;
      const hasMultiAgent = form.hasMultiAgent.checked;
      const requiresApproval = form.requiresApproval.checked;

      let visible = 0;
      for (const item of items) {
        const text = item.dataset.text ?? "";
        const categories = (item.dataset.categories ?? "").split(",");
        const match =
          (!q || text.toLowerCase().includes(q)) &&
          (!category || categories.includes(category)) &&
          (!sourceType || item.dataset.source === sourceType) &&
          (!difficulty || item.dataset.difficulty === difficulty) &&
          (!hasRoutine || item.dataset.routine === "true") &&
          (!hasMultiAgent || item.dataset.multi === "true") &&
          (!requiresApproval || item.dataset.approval === "true");
        item.hidden = !match;
        if (match) visible += 1;
      }

      if (count) {
        const locale = document.documentElement.dataset.locale === "en" ? "en" : "zh";
        const tpl = count.getAttribute(locale === "en" ? "data-count-en" : "data-count-zh") ?? "";
        count.textContent = tpl.replace("{n}", String(visible)).replace("{total}", String(total));
      }
      if (empty) empty.toggleAttribute("hidden", visible !== 0);
    };

    const params = new URLSearchParams(location.search);
    for (const [key, value] of params.entries()) {
      const field = form.elements.namedItem(key);
      if (field instanceof HTMLInputElement && field.type === "checkbox") {
        field.checked = value === "1" || value === "true";
      } else if (field instanceof HTMLInputElement || field instanceof HTMLSelectElement) {
        field.value = value;
      }
    }

    const syncUrl = () => {
      const data = new FormData(form);
      const next = new URLSearchParams();
      for (const [key, value] of data.entries()) {
        if (!value) continue;
        if (value === "on") next.set(key, "1");
        else next.set(key, String(value));
      }
      const qs = next.toString();
      history.replaceState(null, "", qs ? `?${qs}` : location.pathname);
    };

    form.addEventListener("input", () => {
      apply();
      syncUrl();
    });
    form.addEventListener("reset", () => {
      requestAnimationFrame(() => {
        apply();
        syncUrl();
      });
    });
    document.addEventListener("localechange", apply);
    apply();
  }
</script>

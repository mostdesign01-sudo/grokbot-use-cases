---
import BrandMark from "./BrandMark.astro";
import GitHubStar from "./GitHubStar.astro";
import Loc from "./Loc.astro";
import { withBase, isCurrentPath, isSectionPath } from "../lib/paths";
import { ui } from "../lib/i18n";
import { siteName } from "../lib/site";

const path = Astro.url.pathname;
const htmlRoot = withBase("html/");
const agentUiRoot = withBase("agent-ui/");
const searchRoot = withBase("search/");
const libParam = Astro.url.searchParams.get("lib");
const isHtml = isSectionPath(path, htmlRoot) || (isCurrentPath(path, searchRoot) && libParam === "html");
const isAgentUi = isSectionPath(path, agentUiRoot) || (isCurrentPath(path, searchRoot) && libParam === "agent-ui");
const isGrok =
  isSectionPath(path, withBase("cases/")) ||
  isSectionPath(path, withBase("featured/")) ||
  isSectionPath(path, withBase("latest/")) ||
  isSectionPath(path, withBase("types/")) ||
  (isCurrentPath(path, searchRoot) && libParam === "grok");

const currentLib = isAgentUi ? "agent-ui" : isHtml ? "html" : isGrok ? "grok" : "lab";

type NavLink = { href: string; label: { zh: string; en: string }; section?: boolean; favorites?: boolean };

/** Visitor favorites live in localStorage; the badge count is painted client-side. */
const favoritesLink: NavLink = { href: withBase("favorites/"), label: ui.nav.favorites, favorites: true };

const labPrimary: NavLink[] = [
  { href: withBase("/"), label: ui.nav.home },
  { href: withBase("paths/"), label: ui.nav.paths, section: true },
  { href: withBase("models/"), label: ui.nav.models, section: true },
  { href: withBase("search/"), label: ui.nav.search },
  favoritesLink,
];

const labMore: NavLink[] = [
  { href: withBase("combos/"), label: ui.nav.combos, section: true },
  { href: withBase("image-prompts/"), label: ui.nav.imagePrompts, section: true },
  { href: withBase("docs/"), label: ui.nav.docs },
  { href: withBase("changelog/"), label: ui.nav.changelog },
];

const grokLinks: NavLink[] = [
  { href: withBase("cases/"), label: ui.nav.overview },
  { href: withBase("featured/"), label: ui.nav.featured },
  { href: withBase("latest/"), label: ui.nav.latest },
  { href: withBase("types/"), label: ui.nav.types, section: true },
  { href: withBase("search/?lib=grok"), label: ui.nav.search },
  favoritesLink,
];

const htmlLinks: NavLink[] = [
  { href: withBase("html/"), label: ui.nav.overview },
  { href: withBase("html/featured/"), label: ui.nav.featured },
  { href: withBase("html/latest/"), label: ui.nav.latest },
  { href: withBase("html/types/"), label: ui.nav.types, section: true },
  { href: withBase("search/?lib=html"), label: ui.nav.search },
  favoritesLink,
];

const agentUiLinks: NavLink[] = [
  { href: withBase("agent-ui/"), label: ui.nav.overview },
  { href: withBase("agent-ui/featured/"), label: ui.nav.featured },
  { href: withBase("agent-ui/latest/"), label: ui.nav.latest },
  { href: withBase("agent-ui/types/"), label: ui.nav.types, section: true },
  { href: withBase("search/?lib=agent-ui"), label: ui.nav.search },
  favoritesLink,
];

const links: NavLink[] =
  currentLib === "agent-ui" ? agentUiLinks : currentLib === "html" ? htmlLinks : currentLib === "grok" ? grokLinks : labPrimary;
const moreLinks: NavLink[] = currentLib === "lab" ? labMore : [];

function linkCurrent(link: NavLink): boolean {
  return link.section ? isSectionPath(path, link.href) : isCurrentPath(path, link.href);
}

const moreCurrent = moreLinks.some((link) => linkCurrent(link));

const brandLine =
  currentLib === "agent-ui"
    ? ui.brand.agentUi
    : currentLib === "html"
      ? ui.brand.html
      : currentLib === "grok"
        ? ui.brand.grok
        : ui.brand.lab;
---

<header class="site-header">
  <div class="wrap header-inner">
    <div class="header-start">
      <a class="brand" href={withBase("/")}>
        <span class="brand-mark" aria-hidden="true">
          <BrandMark />
        </span>
        <span class="brand-text">
          <strong>{siteName}</strong>
          <span><Loc zh={brandLine.zh} en={brandLine.en} /></span>
        </span>
      </a>
      <nav class="collection-tabs" aria-label={ui.header.collections.zh} data-aria-zh={ui.header.collections.zh} data-aria-en={ui.header.collections.en}>
        <a
          class="tab-grok"
          href={withBase("cases/")}
          aria-current={currentLib === "grok" ? "page" : undefined}
        >
          Grok Bot
        </a>
        <a
          class="tab-html"
          href={withBase("html/")}
          aria-current={currentLib === "html" ? "page" : undefined}
        >
          <Loc zh={ui.lib.html.zh} en={ui.lib.html.en} />
        </a>
        <a
          class="tab-agent-ui"
          href={withBase("agent-ui/")}
          aria-current={currentLib === "agent-ui" ? "page" : undefined}
        >
          Agent UI
        </a>
      </nav>
    </div>
    <nav class="nav" aria-label={ui.header.sections.zh} data-aria-zh={ui.header.sections.zh} data-aria-en={ui.header.sections.en}>
      <div class="nav-links">
      {
        links.map((link) => (
          <a href={link.href} aria-current={linkCurrent(link) ? "page" : undefined}>
            <Loc zh={link.label.zh} en={link.label.en} />
            {link.favorites && <span class="fav-count" data-fav-count hidden aria-hidden="true"></span>}
          </a>
        ))
      }
      {
        moreLinks.length > 0 && (
          <details class="nav-more" data-nav-more>
            <summary class:list={[{ "is-current": moreCurrent }]}>
              <Loc zh={ui.nav.more.zh} en={ui.nav.more.en} />
            </summary>
            <div class="nav-more-menu">
              {moreLinks.map((link) => (
                <a href={link.href} aria-current={linkCurrent(link) ? "page" : undefined}>
                  <Loc zh={link.label.zh} en={link.label.en} />
                </a>
              ))}
            </div>
          </details>
        )
      }
      </div>
      <div class="nav-tools">
      <GitHubStar variant="pill" />
      <div class="locale-toggle" role="group" aria-label={ui.header.locale.zh} data-aria-zh={ui.header.locale.zh} data-aria-en={ui.header.locale.en}>
        <button type="button" data-locale-set="zh" aria-pressed="true">ZH</button>
        <span aria-hidden="true">|</span>
        <button type="button" data-locale-set="en" aria-pressed="false">EN</button>
      </div>
      <button
        class="theme-toggle"
        type="button"
        data-theme-toggle
        aria-label={ui.header.theme.zh}
        data-aria-zh={ui.header.theme.zh}
        data-aria-en={ui.header.theme.en}
      >
        <svg class="theme-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.4" />
          <path fill="currentColor" d="M8 1.75a6.25 6.25 0 0 0 0 12.5V1.75Z" />
        </svg>
      </button>
      </div>
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-locale-set]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const next = button.dataset.localeSet === "en" ? "en" : "zh";
      const apply = (window as Window & { __applyLocale?: (locale: string, persist?: boolean) => void }).__applyLocale;
      apply?.(next, true);
    });
  });

  const themeButton = document.querySelector("[data-theme-toggle]");
  themeButton?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });

  const menus = document.querySelectorAll<HTMLDetailsElement>("details[data-nav-more]");
  document.addEventListener("click", (event) => {
    const target = event.target as Node | null;
    menus.forEach((menu) => {
      if (!menu.open || (target && menu.contains(target))) return;
      menu.open = false;
    });
  });
  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;
    menus.forEach((menu) => {
      menu.open = false;
    });
  });
  menus.forEach((menu) => {
    menu.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (next && menu.contains(next)) return;
      menu.open = false;
    });
  });
</script>

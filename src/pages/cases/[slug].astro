---
import Badge from "../../components/Badge.astro";
import CaseCard from "../../components/CaseCard.astro";
import Loc from "../../components/Loc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { cases, getRelatedCases } from "../../lib/cases";
import { formatPublishedDate, formatShanghaiDateTime } from "../../lib/format";
import { fill, ui } from "../../lib/i18n";
import {
  categoryLabel,
  connectorLabel,
  difficultyLabel,
  isCommunity,
  isCursorAdjacent,
  isOfficial,
  sourceTypeLabel,
} from "../../lib/labels";
import { assetUrl, withBase } from "../../lib/paths";

export function getStaticPaths() {
  return cases.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const related = getRelatedCases(item);
const sources = [item.sourceUrl, ...(item.secondaryUrls ?? [])];
const summaryEn = item.summaryEn ?? item.summary;
const qualityEn = item.qualityNoteEn ?? item.qualityNote;
const boundZh = item.approvalBoundary;
const boundEn = item.approvalBoundaryEn ?? item.approvalBoundary;
const safeWithBound = boundZh
  ? fill(ui.detail.safeWithBound, { bound: boundZh })
  : ui.detail.safeDefault;
const safeWithBoundEn = boundEn
  ? fill(ui.detail.safeWithBound, { bound: boundEn })
  : ui.detail.safeDefault;
---

<BaseLayout
  collection="grok"
  title={`${item.title} · AI UP LAB`}
  titleEn={`${item.titleEn} · AI UP LAB`}
  description={item.summary}
  descriptionEn={summaryEn}
>
  <div class="wrap">
    <article class="detail-hero">
      <p class="crumb">
        <a href={withBase("/")}><Loc zh={ui.detail.lab.zh} en={ui.detail.lab.en} /></a> /
        <a href={withBase("cases/")}>Grok Bot</a> /
        <span class="loc-zh">{item.title}</span>
        <span class="loc-en">{item.titleEn}</span>
      </p>
      <div class="badges">
        {isOfficial(item.sourceType) && <Badge kind="official" label={ui.badge.official.zh} labelEn={ui.badge.official.en} />}
        {isCommunity(item.sourceType) && <Badge kind="community" label={ui.badge.community.zh} labelEn={ui.badge.community.en} />}
        {isCursorAdjacent(item.sourceType) && <Badge kind="cursor" label={ui.badge.cursor.zh} labelEn={ui.badge.cursor.en} />}
        {item.requiresApproval && <Badge kind="approval" label={ui.badge.approval.zh} labelEn={ui.badge.approval.en} />}
        {item.hasRoutine && <Badge kind="routine" label={ui.badge.routine.zh} labelEn={ui.badge.routine.en} />}
        {item.hasMultiAgent && <Badge kind="multi" label={ui.badge.multi.zh} labelEn={ui.badge.multi.en} />}
        {item.hasSkill && <Badge label={ui.badge.skill.zh} labelEn={ui.badge.skill.en} />}
      </div>
      <h1>
        <span class="loc-zh">{item.title}</span>
        <span class="loc-en">{item.titleEn}</span>
      </h1>
      <p class="title-en loc-zh">{item.titleEn}</p>
      <p class="lede">
        <span class="loc-zh">{item.summary}</span>
        <span class="loc-en">{summaryEn}</span>
      </p>
      {
        item.previewImage && (
          <figure class="detail-preview">
            <img src={assetUrl(item.previewImage)} alt="" />
          </figure>
        )
      }
    </article>

    <div class="detail-grid">
      <div>
        <section class="panel">
          <h2><Loc zh={ui.detail.whatItDoes.zh} en={ui.detail.whatItDoes.en} /></h2>
          <p>
            <span class="loc-zh">{item.summary}</span>
            <span class="loc-en">{summaryEn}</span>
          </p>
          <p class="quality-note">
            <strong><Loc zh={ui.quality.zh} en={ui.quality.en} /></strong>
            <span class="loc-zh">{item.qualityNote}</span>
            <span class="loc-en">{qualityEn}</span>
          </p>
        </section>

        <section class="panel">
          <h2><Loc zh={ui.detail.startPath.zh} en={ui.detail.startPath.en} /></h2>
          {
            item.approvalBoundary && (
              <div class="approval-callout">
                <strong><Loc zh={ui.detail.approvalBound.zh} en={ui.detail.approvalBound.en} /></strong>
                <p>
                  <span class="loc-zh">{item.approvalBoundary}</span>
                  <span class="loc-en">{boundEn}</span>
                </p>
              </div>
            )
          }
          <ol class="start-path">
            <li>
              <strong><Loc zh={ui.detail.safeStep.zh} en={ui.detail.safeStep.en} /></strong>
              <p>
                <span class="loc-zh">{item.approvalBoundary ? safeWithBound.zh : ui.detail.safeDefault.zh}</span>
                <span class="loc-en">{item.approvalBoundary ? safeWithBoundEn.en : ui.detail.safeDefault.en}</span>
              </p>
            </li>
            <li>
              <strong><Loc zh={ui.detail.saveSkill.zh} en={ui.detail.saveSkill.en} /></strong>
              <p>
                <span class="loc-zh">{item.hasSkill ? ui.detail.skillYes.zh : ui.detail.skillNo.zh}</span>
                <span class="loc-en">{item.hasSkill ? ui.detail.skillYes.en : ui.detail.skillNo.en}</span>
              </p>
            </li>
            <li>
              <strong><Loc zh={ui.detail.thenRoutine.zh} en={ui.detail.thenRoutine.en} /></strong>
              <p>
                <span class="loc-zh">{item.hasRoutine ? ui.detail.routineYes.zh : ui.detail.routineNo.zh}</span>
                <span class="loc-en">{item.hasRoutine ? ui.detail.routineYes.en : ui.detail.routineNo.en}</span>
              </p>
            </li>
          </ol>
        </section>

        {
          related.length > 0 && (
            <section class="section">
              <h2><Loc zh={ui.detail.related.zh} en={ui.detail.related.en} /></h2>
              <div class="tweet-feed tweet-feed-related">
                {related.map((relatedItem) => (
                  <CaseCard caseItem={relatedItem} />
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside>
        <section class="panel">
          <h2><Loc zh={ui.detail.metadata.zh} en={ui.detail.metadata.en} /></h2>
          <dl class="kv">
            <div>
              <dt><Loc zh={ui.meta.role.zh} en={ui.meta.role.en} /></dt>
              <dd>{item.role}</dd>
            </div>
            <div>
              <dt><Loc zh={ui.meta.sourceType.zh} en={ui.meta.sourceType.en} /></dt>
              <dd>
                <span class="loc-zh">{sourceTypeLabel(item.sourceType)}</span>
                <span class="loc-en">{sourceTypeLabel(item.sourceType, "en")}</span>
              </dd>
            </div>
            <div>
              <dt><Loc zh={ui.meta.difficulty.zh} en={ui.meta.difficulty.en} /></dt>
              <dd>
                <span class="loc-zh">{difficultyLabel(item.difficulty)}</span>
                <span class="loc-en">{difficultyLabel(item.difficulty, "en")}</span>
              </dd>
            </div>
            <div>
              <dt><Loc zh={ui.meta.categories.zh} en={ui.meta.categories.en} /></dt>
              <dd class="chips">
                {item.categories.map((cat) => (
                  <span class="chip">
                    <span class="loc-zh">{categoryLabel(cat)}</span>
                    <span class="loc-en">{categoryLabel(cat, "en")}</span>
                  </span>
                ))}
              </dd>
            </div>
            <div>
              <dt><Loc zh={ui.meta.connectors.zh} en={ui.meta.connectors.en} /></dt>
              <dd class="chips">
                {item.connectors.length
                  ? item.connectors.map((value) => (
                      <span class="chip">
                        <span class="loc-zh">{connectorLabel(value)}</span>
                        <span class="loc-en">{connectorLabel(value, "en")}</span>
                      </span>
                    ))
                  : <Loc zh={ui.meta.noneListed.zh} en={ui.meta.noneListed.en} />}
              </dd>
            </div>
            <div>
              <dt><Loc zh={ui.meta.published.zh} en={ui.meta.published.en} /></dt>
              <dd>
                <span class="loc-zh">{formatPublishedDate(item.publishedAt)}</span>
                <span class="loc-en">{formatPublishedDate(item.publishedAt, "en-US")}</span>
              </dd>
            </div>
            <div>
              <dt><Loc zh={ui.meta.itemUpdated.zh} en={ui.meta.itemUpdated.en} /></dt>
              <dd>
                <span class="loc-zh">{formatShanghaiDateTime(item.updatedAt)}</span>
                <span class="loc-en">{formatShanghaiDateTime(item.updatedAt, "en-US")}</span>
              </dd>
            </div>
          </dl>
        </section>
        <section class="panel">
          <h2><Loc zh={ui.meta.publicSources.zh} en={ui.meta.publicSources.en} /></h2>
          <div class="source-list">
            {sources.map((href) => (
              <a href={href} rel="noreferrer">
                {href}
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

---
import HtmlCard from "../../components/HtmlCard.astro";
import Loc from "../../components/Loc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getFeaturedHtml } from "../../lib/html";
import { fill, ui } from "../../lib/i18n";
import { withBase } from "../../lib/paths";

const featured = getFeaturedHtml();
const lede = fill(ui.html.featuredLede, { n: featured.length });
---

<BaseLayout
  collection="html"
  title={ui.html.featuredTitle.zh}
  titleEn={ui.html.featuredTitle.en}
  description={ui.html.featuredDesc.zh}
  descriptionEn={ui.html.featuredDesc.en}
>
  <div class="wrap-wide">
    <section class="collection-hero">
      <p class="kicker">Featured HTML</p>
      <h1><Loc zh={ui.html.featuredH1.zh} en={ui.html.featuredH1.en} /></h1>
      <p class="lede"><Loc zh={lede.zh} en={lede.en} /></p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("html/latest/")}><Loc zh={ui.html.latestHtml.zh} en={ui.html.latestHtml.en} /></a>
        <a class="btn btn-ghost" href={withBase("html/types/")}><Loc zh={ui.footer.byType.zh} en={ui.footer.byType.en} /></a>
      </div>
    </section>
    <section class="section">
      <div class="masonry">
        {featured.map((item) => <HtmlCard item={item} />)}
      </div>
    </section>
  </div>
</BaseLayout>

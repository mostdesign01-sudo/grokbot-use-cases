---
import type { CaseItem } from "../lib/cases";
import { categoryLabel, difficultyLabel, sourceBadgeKind, sourceBadgeLabel } from "../lib/labels";
import { withBase } from "../lib/paths";
import Badge from "./Badge.astro";
import QualityNote from "./QualityNote.astro";

interface Props {
  caseItem: CaseItem;
}

const { caseItem } = Astro.props;
---

<a class="case-card" href={withBase(`cases/${caseItem.slug}/`)}>
  <div class="badges">
    <Badge kind={sourceBadgeKind(caseItem.sourceType)} label={sourceBadgeLabel(caseItem.sourceType)} />
    <Badge kind="difficulty" label={difficultyLabel(caseItem.difficulty)} />
    {caseItem.requiresApproval && <Badge kind="approval" label="需审批" />}
    {caseItem.hasRoutine && <Badge kind="routine" label="例行" />}
    {caseItem.hasMultiAgent && <Badge kind="multi" label="多Agent" />}
    {caseItem.featured && <Badge kind="featured" label="+ 精选" />}
  </div>
  <h3>{caseItem.title}</h3>
  <p class="title-en">{caseItem.titleEn}</p>
  <p class="summary">{caseItem.summary}</p>
  <QualityNote note={caseItem.qualityNote} />
  <div class="card-meta">
    <span>{caseItem.role}</span>
    <span>{caseItem.categories.map(categoryLabel).join(" · ")}</span>
  </div>
</a>

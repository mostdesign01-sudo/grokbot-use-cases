---
import HtmlCard from "../../components/HtmlCard.astro";
import LibrarySearch from "../../components/LibrarySearch.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatShanghaiDateTime } from "../../lib/format";
import { getFeaturedHtml, getHtmlTypeCollections, htmlItems, htmlMeta, htmlSearchText } from "../../lib/html";
import { htmlTypeLabel } from "../../lib/html-labels";
import { withBase } from "../../lib/paths";
import { pageTitle, siteName } from "../../lib/site";

const featuredIds = new Set(getFeaturedHtml().map((item) => item.id));
const wall = [...htmlItems].sort((a, b) => Number(featuredIds.has(b.id)) - Number(featuredIds.has(a.id)));
const types = getHtmlTypeCollections();
---

<BaseLayout
  collection="html"
  title={pageTitle("HTML 收集")}
  description={`${siteName} 的 HTML 收集库：从公开网页收集的演示、模板、组件与工具页。`}
>
  <div class="wrap-wide" data-hub>
    <section class="hub-intro">
      <p class="kicker">{siteName} · HTML 收集</p>
      <h1>公开网页里的 HTML 范例</h1>
      <p class="lede">
        演示、模板、组件与工具页，和 Grok Bot、Agent UI 分开。有预览图就上墙，没有就用青绿海报。
      </p>
      <LibrarySearch library="html" placeholder="搜索 HTML 标题、摘要、标签、收录理由…" />
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("html/featured/")}>精选</a>
        <a class="btn btn-ghost" href={withBase("html/latest/")}>最新</a>
        <a class="btn btn-ghost" href={withBase("html/types/")}>按类型</a>
      </div>
      <p class="meta-line">最近校对（Asia/Shanghai）：{formatShanghaiDateTime(htmlMeta.updatedAt)} · {htmlItems.length} 条</p>
      <div class="type-chips">
        {
          types.map((item) => (
            <a class="type-chip" href={withBase(`html/types/${item.type}/`)}>
              <strong>{htmlTypeLabel(item.type)}</strong>
              <span>{item.count}</span>
            </a>
          ))
        }
      </div>
    </section>

    <section class="section" aria-labelledby="html-wall">
      <div class="section-head">
        <div>
          <h2 id="html-wall">浏览墙</h2>
          <p>精选靠前。点卡片进详情，原文仍在站外。</p>
        </div>
      </div>
      <div class="masonry">
        {
          wall.map((item) => (
            <div data-filter-card data-filter-text={htmlSearchText(item)}>
              <HtmlCard item={item} />
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

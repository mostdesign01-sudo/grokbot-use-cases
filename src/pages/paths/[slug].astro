---
import AgentUiCard from "../../components/AgentUiCard.astro";
import CaseCard from "../../components/CaseCard.astro";
import HtmlCard from "../../components/HtmlCard.astro";
import Loc from "../../components/Loc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPublishedDate } from "../../lib/format";
import { ui } from "../../lib/i18n";
import { difficultyLabel } from "../../lib/labels";
import { withBase } from "../../lib/paths";
import {
  filledPathBrief,
  getRelatedAgentUiForPath,
  getRelatedCasesForPath,
  getRelatedHtmlForPath,
  playbooks,
} from "../../lib/playbooks";
import Badge from "../../components/Badge.astro";

export function getStaticPaths() {
  return playbooks.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const relatedCases = getRelatedCasesForPath(item);
const relatedHtml = getRelatedHtmlForPath(item);
const relatedAgentUi = getRelatedAgentUiForPath(item);
const hasRelated = relatedCases.length + relatedHtml.length + relatedAgentUi.length + item.relatedPages.length > 0;
const run = item.run;
const briefZh = run ? filledPathBrief(item, "zh") : "";
const briefEn = run ? filledPathBrief(item, "en") : "";
---

<BaseLayout
  collection="lab"
  title={`${item.title} · AI UP LAB`}
  titleEn={`${item.titleEn} · AI UP LAB`}
  description={item.summary}
  descriptionEn={item.summaryEn}
>
  <div class="wrap">
    <article class="detail-hero">
      <p class="crumb">
        <a href={withBase("/")}><Loc zh={ui.detail.lab.zh} en={ui.detail.lab.en} /></a> /
        <a href={withBase("paths/")}><Loc zh={ui.nav.paths.zh} en={ui.nav.paths.en} /></a> /
        <span class="loc-zh">{item.title}</span>
        <span class="loc-en">{item.titleEn}</span>
      </p>
      <div class="badges">
        <Badge
          kind="approval"
          label={difficultyLabel(item.difficulty)}
          labelEn={difficultyLabel(item.difficulty, "en")}
        />
        {
          item.featured && (
            <Badge kind="featured" label={ui.badge.featured.zh} labelEn={ui.badge.featured.en} />
          )
        }
      </div>
      <h1>
        <span class="loc-zh">{item.title}</span>
        <span class="loc-en">{item.titleEn}</span>
      </h1>
      <p class="title-en loc-zh">{item.titleEn}</p>
      <p class="lede">
        <span class="loc-zh">{item.summary}</span>
        <span class="loc-en">{item.summaryEn}</span>
      </p>
      {
        run && (
          <div class="hero-actions path-run-actions">
            <button
              type="button"
              class="btn btn-primary btn-lg"
              data-path-run-toggle
              aria-expanded="false"
              aria-controls="path-run-panel"
            >
              <Loc zh={ui.path.run.zh} en={ui.path.run.en} />
            </button>
            {hasRelated && (
              <a class="btn btn-ghost" href="#path-related">
                <Loc zh={ui.path.related.zh} en={ui.path.related.en} />
              </a>
            )}
          </div>
        )
      }
      {
        run && (
          <section
            id="path-run-panel"
            class="path-run-panel"
            hidden
            data-path-run-panel
            aria-label={ui.path.run.zh}
            data-aria-zh={ui.path.run.zh}
            data-aria-en={ui.path.run.en}
          >
            <p class="path-run-desk">
              <strong>
                <Loc zh={ui.path.dropDesk.zh} en={ui.path.dropDesk.en} />
              </strong>
              <span class="loc-zh">
                {run.desk}
                <span class="path-run-hint">{run.targetHint}</span>
              </span>
              <span class="loc-en">
                {run.deskEn}
                <span class="path-run-hint">{run.targetHintEn}</span>
              </span>
            </p>
            <p class="path-run-note">
              <Loc zh={ui.path.runHint.zh} en={ui.path.runHint.en} />
            </p>
            <pre class="path-run-brief loc-zh" data-path-brief>{briefZh}</pre>
            <pre class="path-run-brief loc-en">{briefEn}</pre>
            <div class="path-run-copy-row">
              <button type="button" class="btn btn-ghost" data-path-copy>
                <span data-path-copy-label>
                  <Loc zh={ui.path.copyBrief.zh} en={ui.path.copyBrief.en} />
                </span>
                <span class="path-run-copied" hidden data-path-copied aria-live="polite">
                  <Loc zh={ui.path.copied.zh} en={ui.path.copied.en} />
                </span>
              </button>
            </div>
          </section>
        )
      }
    </article>

    <div class="detail-grid">
      <div>
        <section class="panel">
          <h2><Loc zh={ui.path.steps.zh} en={ui.path.steps.en} /></h2>
          <ol class="start-path">
            {
              item.steps.map((step) => (
                <li>
                  <strong>
                    <span class="loc-zh">{step.title}</span>
                    <span class="loc-en">{step.titleEn}</span>
                  </strong>
                  <p>
                    <span class="loc-zh">{step.body}</span>
                    <span class="loc-en">{step.bodyEn}</span>
                  </p>
                </li>
              ))
            }
          </ol>
        </section>

        <section class="panel">
          <h2><Loc zh={ui.path.gates.zh} en={ui.path.gates.en} /></h2>
          {
            item.gates.map((gate) => (
              <div class="approval-callout">
                <strong>
                  <span class="loc-zh">{gate.title}</span>
                  <span class="loc-en">{gate.titleEn}</span>
                </strong>
                {(gate.body || gate.bodyEn) && (
                  <p>
                    <span class="loc-zh">{gate.body ?? gate.bodyEn}</span>
                    <span class="loc-en">{gate.bodyEn ?? gate.body}</span>
                  </p>
                )}
              </div>
            ))
          }
        </section>

        {
          hasRelated && (
            <section class="section" id="path-related">
              <h2><Loc zh={ui.path.related.zh} en={ui.path.related.en} /></h2>
              {
                item.relatedPages.length > 0 && (
                  <div class="path-page-links">
                    {item.relatedPages.map((page) => (
                      <a class="card" href={withBase(page.href)}>
                        <h3>
                          <span class="loc-zh">{page.title}</span>
                          <span class="loc-en">{page.titleEn}</span>
                        </h3>
                        <p class="title-en loc-zh">{page.titleEn}</p>
                      </a>
                    ))}
                  </div>
                )
              }
              {
                relatedCases.length > 0 && (
                  <div class="tweet-feed tweet-feed-related">
                    {relatedCases.map((relatedItem) => (
                      <CaseCard caseItem={relatedItem} />
                    ))}
                  </div>
                )
              }
              {
                (relatedHtml.length > 0 || relatedAgentUi.length > 0) && (
                  <div class="masonry masonry-related">
                    {relatedHtml.map((htmlItem) => (
                      <HtmlCard item={htmlItem} />
                    ))}
                    {relatedAgentUi.map((agentItem) => (
                      <AgentUiCard item={agentItem} />
                    ))}
                  </div>
                )
              }
            </section>
          )
        }
      </div>

      <aside>
        <section class="panel">
          <h2><Loc zh={ui.detail.metadata.zh} en={ui.detail.metadata.en} /></h2>
          <dl class="kv">
            <div>
              <dt><Loc zh={ui.meta.difficulty.zh} en={ui.meta.difficulty.en} /></dt>
              <dd>
                <span class="loc-zh">{difficultyLabel(item.difficulty)}</span>
                <span class="loc-en">{difficultyLabel(item.difficulty, "en")}</span>
              </dd>
            </div>
            <div>
              <dt><Loc zh={ui.path.stepCount.zh} en={ui.path.stepCount.en} /></dt>
              <dd>{item.steps.length}</dd>
            </div>
            <div>
              <dt><Loc zh={ui.path.gateCount.zh} en={ui.path.gateCount.en} /></dt>
              <dd>{item.gates.length}</dd>
            </div>
            <div>
              <dt><Loc zh={ui.meta.published.zh} en={ui.meta.published.en} /></dt>
              <dd>
                <span class="loc-zh">{formatPublishedDate(item.publishedAt)}</span>
                <span class="loc-en">{formatPublishedDate(item.publishedAt, "en-US")}</span>
              </dd>
            </div>
          </dl>
        </section>
        <section class="panel">
          <h2><Loc zh={ui.path.otherPaths.zh} en={ui.path.otherPaths.en} /></h2>
          <div class="source-list">
            {
              playbooks
                .filter((other) => other.id !== item.id)
                .map((other) => (
                  <a href={withBase(`paths/${other.slug}/`)}>
                    <span class="loc-zh">{other.title}</span>
                    <span class="loc-en">{other.titleEn}</span>
                  </a>
                ))
            }
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

{
  run && (
    <script>
      const toggle = document.querySelector<HTMLButtonElement>("[data-path-run-toggle]");
      const panel = document.querySelector<HTMLElement>("[data-path-run-panel]");
      const copyButton = document.querySelector<HTMLButtonElement>("[data-path-copy]");
      const copyLabel = document.querySelector<HTMLElement>("[data-path-copy-label]");
      const copied = document.querySelector<HTMLElement>("[data-path-copied]");
      const brief = document.querySelector<HTMLElement>("[data-path-brief]");

      toggle?.addEventListener("click", () => {
        if (!panel) return;
        const open = !panel.hasAttribute("hidden");
        if (open) {
          panel.setAttribute("hidden", "");
          toggle.setAttribute("aria-expanded", "false");
        } else {
          panel.removeAttribute("hidden");
          toggle.setAttribute("aria-expanded", "true");
        }
      });

      function copyTextSync(text: string): boolean {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.position = "fixed";
        area.style.left = "-9999px";
        document.body.appendChild(area);
        area.select();
        let ok = false;
        try {
          ok = document.execCommand("copy");
        } catch {
          ok = false;
        }
        area.remove();
        return ok;
      }

      function showCopied() {
        if (!copied || !copyLabel) return;
        copyLabel.hidden = true;
        copied.removeAttribute("hidden");
        window.setTimeout(() => {
          copied.setAttribute("hidden", "");
          copyLabel.hidden = false;
        }, 2000);
      }

      copyButton?.addEventListener("click", () => {
        const text = brief?.textContent?.trim() ?? "";
        if (!text) return;
        if (!copyTextSync(text)) {
          void navigator.clipboard?.writeText(text);
        }
        showCopied();
      });
    </script>
  )
}

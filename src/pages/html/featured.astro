---
import HtmlCard from "../../components/HtmlCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getFeaturedHtml } from "../../lib/html";
import { withBase } from "../../lib/paths";

const featured = getFeaturedHtml();
---

<BaseLayout collection="html" title="精选 HTML · HTML 收集" description="编辑精选的公开 HTML 演示与模板。">
  <div class="wrap">
    <section class="collection-hero">
      <p class="kicker">Featured HTML</p>
      <h1>精选 HTML</h1>
      <p class="lede">
        <code>featured === true</code> 的公开页面，当前 {featured.length} 条。原文均在站外，本站只做索引。
      </p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("html/latest/")}>最新 HTML</a>
        <a class="btn btn-ghost" href={withBase("html/types/")}>按类型</a>
      </div>
    </section>
    <section class="section">
      <div class="grid">
        {featured.map((item) => <HtmlCard item={item} />)}
      </div>
    </section>
  </div>
</BaseLayout>

---
import AgentUiCard from "../../components/AgentUiCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLatestAgentUi } from "../../lib/agent-ui";
import { formatPublishedDate } from "../../lib/format";
import { withBase } from "../../lib/paths";

const latest = getLatestAgentUi();
---

<BaseLayout collection="agent-ui" title="最新 Agent UI · AI UP LAB" description="按公开日期排序的 Agent UI 收集。">
  <div class="wrap">
    <section class="collection-hero">
      <p class="kicker">Latest Agent UI</p>
      <h1>最新 Agent UI</h1>
      <p class="lede">按 <code>publishedAt</code> 再按 <code>updatedAt</code> 从新到旧。当前 {latest.length} 条。</p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("agent-ui/featured/")}>精选</a>
        <a class="btn btn-ghost" href={withBase("agent-ui/types/")}>按类型</a>
      </div>
    </section>
    <section class="section">
      <div class="grid">
        {
          latest.map((item) => (
            <div class="collection-card">
              <p class="collection-date">公开约 {formatPublishedDate(item.publishedAt)}</p>
              <AgentUiCard item={item} />
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

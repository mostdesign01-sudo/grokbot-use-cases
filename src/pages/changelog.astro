---
import Loc from "../components/Loc.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { changelogNotes, meta } from "../lib/cases";
import { formatShanghaiDate, formatShanghaiDateTime, groupByShanghaiDay } from "../lib/format";
import { ui } from "../lib/i18n";

const groups = groupByShanghaiDay(changelogNotes, (note) => note.date);
---

<BaseLayout
  collection="lab"
  title={ui.pages.changelogTitle.zh}
  titleEn={ui.pages.changelogTitle.en}
  description={ui.pages.changelogDesc.zh}
  descriptionEn={ui.pages.changelogDesc.en}
>
  <div class="wrap">
    <p class="kicker">Changelog</p>
    <h1><Loc zh={ui.pages.changelogH1.zh} en={ui.pages.changelogH1.en} /></h1>
    <p class="lede">
      <span class="loc-zh">
        AI UP LAB 的数据更新时间以 <code>data/cases.json</code> 的 <code>meta.updatedAt</code> 为准，并按 Asia/Shanghai 显示。
      </span>
      <span class="loc-en">
        AI UP LAB data freshness follows <code>meta.updatedAt</code> in <code>data/cases.json</code>, shown in Asia/Shanghai.
      </span>
    </p>

    <section class="stats" aria-label={ui.pages.dataVersion.zh} data-aria-zh={ui.pages.dataVersion.zh} data-aria-en={ui.pages.dataVersion.en}>
      <div class="stat">
        <b>{meta.version}</b>
        <span><Loc zh={ui.pages.datasetVersion.zh} en={ui.pages.datasetVersion.en} /></span>
      </div>
      <div class="stat">
        <b>{meta.count}</b>
        <span><Loc zh={ui.pages.caseCount.zh} en={ui.pages.caseCount.en} /></span>
      </div>
      <div class="stat">
        <b>
          <span class="loc-zh">{formatShanghaiDate(meta.updatedAt)}</span>
          <span class="loc-en">{formatShanghaiDate(meta.updatedAt, "en-US")}</span>
        </b>
        <span><Loc zh={ui.pages.lastUpdateDate.zh} en={ui.pages.lastUpdateDate.en} /></span>
      </div>
      <div class="stat">
        <b>{meta.timezone}</b>
        <span><Loc zh={ui.pages.displayTz.zh} en={ui.pages.displayTz.en} /></span>
      </div>
    </section>

    <section class="section">
      <h2>meta.updatedAt</h2>
      <p><Loc zh={ui.pages.iso.zh} en={ui.pages.iso.en} />：<code>{meta.updatedAt}</code></p>
      <p>
        <Loc zh={ui.pages.shanghaiTime.zh} en={ui.pages.shanghaiTime.en} />：
        <span class="loc-zh">{formatShanghaiDateTime(meta.updatedAt)}</span>
        <span class="loc-en">{formatShanghaiDateTime(meta.updatedAt, "en-US")}</span>
      </p>
    </section>

    <section class="section">
      <h2><Loc zh={ui.pages.recentNotes.zh} en={ui.pages.recentNotes.en} /></h2>
      <div class="feed changelog-feed">
        {
          groups.map((group) => (
            <section class="feed-day">
              <h3 class="feed-day-title">
                <span class="loc-zh">{group.title}</span>
                <span class="loc-en">{group.titleEn}</span>
              </h3>
              <div class="timeline">
                {group.items.map((note) => (
                  <article class="note">
                    <time datetime={note.date}>{note.date}</time>
                    <h3>
                      <span class="loc-zh">{note.title}</span>
                      <span class="loc-en">{note.titleEn ?? note.title}</span>
                    </h3>
                    <p>
                      <span class="loc-zh">{note.body}</span>
                      <span class="loc-en">{note.bodyEn ?? note.body}</span>
                    </p>
                  </article>
                ))}
              </div>
            </section>
          ))
        }
      </div>
    </section>

    <section class="section">
      <h2><Loc zh={ui.pages.crawledSources.zh} en={ui.pages.crawledSources.en} /></h2>
      <div class="source-list">
        {meta.sourcesCrawled.map((href) => (
          <a href={href} rel="noreferrer">
            {href}
          </a>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>

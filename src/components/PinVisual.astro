---
import { assetUrl } from "../lib/paths";
import { pinRatio, type PinLib } from "../lib/pins";

interface Props {
  lib: PinLib;
  title: string;
  titleEn?: string;
  seed: string;
  image?: string;
}

const { lib, title, titleEn = title, seed, image } = Astro.props;
const src = assetUrl(image);
const ratio = src ? "shot" : String(pinRatio(seed));
---

<div
  class:list={["pin-visual", `pin-${lib}`, `pin-ratio-${ratio}`, src && "has-image"]}
  aria-hidden="true"
>
  <div class:list={["pin-art", src ? "pin-pattern-shot" : `pin-pattern-${ratio}`]}>
    <span class="pin-art-title loc-zh">{title}</span>
    <span class="pin-art-title loc-en">{titleEn}</span>
  </div>
  {
    src && (
      <img
        src={src}
        alt=""
        loading="lazy"
        decoding="async"
        onerror="this.hidden=true;this.removeAttribute('src');this.parentElement&&this.parentElement.classList.remove('has-image');"
      />
    )
  }
</div>

---
import BrandMark from "./BrandMark.astro";
import DigestCard from "./DigestCard.astro";
import GitHubStar from "./GitHubStar.astro";
import Loc from "./Loc.astro";
import PlazaCard from "./PlazaCard.astro";
import { agentUiItems } from "../lib/agent-ui";
import { cases, getCaseBySlug } from "../lib/cases";
import {
  dateHref,
  firstSentence,
  getDigestArchive,
  getHomeDigest,
  packPlazaColumns,
  resolveDigestDate,
} from "../lib/digest";
import { shanghaiDateKey } from "../lib/format";
import { htmlItems } from "../lib/html";
import { fill, ui } from "../lib/i18n";
import { assetUrl, withBase } from "../lib/paths";
import { getStealAlso, getWeeklySteal } from "../lib/playbooks";
import { siteName } from "../lib/site";

interface Props {
  dateKey?: string;
}

const { dateKey } = Astro.props;
const latest = resolveDigestDate();
const day = getHomeDigest(dateKey);
const archive = getDigestArchive();
const [col1, col2, col3] = packPlazaColumns(day.items);
const steal = getWeeklySteal();
const also = getStealAlso(steal, 3);
const stealLine = steal
  ? { zh: firstSentence(steal.summary), en: firstSentence(steal.summaryEn) }
  : ui.home.pathsStrip;
const railLinks = [
  { href: withBase("paths/"), label: ui.nav.paths },
  { href: withBase("combos/"), label: ui.nav.combos },
  { href: withBase("models/"), label: ui.nav.models },
  { href: withBase("image-prompts/"), label: ui.nav.imagePrompts },
  { href: withBase("search/"), label: ui.nav.search },
  { href: withBase("favorites/"), label: ui.home.favorites, favorites: true },
  { href: withBase("docs/"), label: ui.nav.docs },
  { href: withBase("changelog/"), label: ui.nav.changelog },
];

const sibling = getCaseBySlug("grokbots-best");
const siblingHref = sibling ? withBase(`cases/${sibling.slug}/`) : "https://grokbots.best";

function shiftDateKey(key: string, days: number): string {
  const [year, month, day] = key.split("-").map(Number);
  const shifted = new Date(Date.UTC(year, month - 1, day + days));
  return [
    shifted.getUTCFullYear(),
    String(shifted.getUTCMonth() + 1).padStart(2, "0"),
    String(shifted.getUTCDate()).padStart(2, "0"),
  ].join("-");
}

function updatedThisWeek(items: { updatedAt: string }[], endKey: string): number {
  const start = shiftDateKey(endKey, -6);
  return items.filter((item) => {
    const key = shanghaiDateKey(item.updatedAt);
    return key >= start && key <= endKey;
  }).length;
}

const libraries = [
  {
    href: withBase("cases/"),
    name: ui.lib.grok,
    count: cases.length,
    week: updatedThisWeek(cases, day.dateKey),
    image: assetUrl("/brand/lib-grok.webp"),
    tone: "plaza-lib-grok",
  },
  {
    href: withBase("html/"),
    name: ui.lib.html,
    count: htmlItems.length,
    week: updatedThisWeek(htmlItems, day.dateKey),
    image: assetUrl("/brand/lib-html.webp"),
    tone: "plaza-lib-html",
  },
  {
    href: withBase("agent-ui/"),
    name: ui.lib.agentUi,
    count: agentUiItems.length,
    week: updatedThisWeek(agentUiItems, day.dateKey),
    image: assetUrl("/brand/lib-agent-ui.webp"),
    tone: "plaza-lib-agent",
  },
].map((lib) => ({
  ...lib,
  countLabel: fill(ui.home.countItems, { n: lib.count }),
  weekLabel: fill(ui.home.weekBadge, { n: lib.week }),
}));
---

<div class="home-shell" data-home-shell>
  <aside class="home-rail">
    <div class="home-rail-top">
      <a class="home-wordmark" href={withBase("/")}>
        <span class="brand-mark" aria-hidden="true">
          <BrandMark />
        </span>
        <span class="home-wordmark-text">
          <strong>{siteName}</strong>
          <span class="home-lede"><Loc zh={ui.home.lede.zh} en={ui.home.lede.en} /></span>
        </span>
      </a>

      <div class="home-rail-tools">
        <div class="locale-toggle" role="group" aria-label={ui.header.locale.zh} data-aria-zh={ui.header.locale.zh} data-aria-en={ui.header.locale.en}>
          <button type="button" data-locale-set="zh" aria-pressed="true">ZH</button>
          <span aria-hidden="true">|</span>
          <button type="button" data-locale-set="en" aria-pressed="false">EN</button>
        </div>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-label={ui.header.theme.zh}
          data-aria-zh={ui.header.theme.zh}
          data-aria-en={ui.header.theme.en}
        >
          <svg class="theme-icon" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <circle cx="8" cy="8" r="6.25" fill="none" stroke="currentColor" stroke-width="1.4" />
            <path fill="currentColor" d="M8 1.75a6.25 6.25 0 0 0 0 12.5V1.75Z" />
          </svg>
        </button>
      </div>

      <GitHubStar variant="rail" />
    </div>

    <nav class="home-dates" aria-label={ui.home.dates.zh} data-aria-zh={ui.home.dates.zh} data-aria-en={ui.home.dates.en}>
      {
        archive.map((entry) => (
          <a
            href={dateHref(entry.dateKey, latest)}
            aria-current={entry.dateKey === day.dateKey ? "page" : undefined}
          >
            <span>
              <Loc zh={entry.dateLabel.zh} en={entry.dateLabel.en} />
            </span>
            <span class="home-date-count">{entry.count}</span>
          </a>
        ))
      }
    </nav>

    <nav class="home-libs" aria-label={ui.home.libraries.zh} data-aria-zh={ui.home.libraries.zh} data-aria-en={ui.home.libraries.en}>
      <p class="home-rail-label"><Loc zh={ui.home.libraries.zh} en={ui.home.libraries.en} /></p>
      <a class="lib-grok" href={withBase("cases/")}>Grok Bot</a>
      <a class="lib-html" href={withBase("html/")}><Loc zh={ui.lib.html.zh} en={ui.lib.html.en} /></a>
      <a class="lib-agent" href={withBase("agent-ui/")}>Agent UI</a>
    </nav>

    <nav class="home-rail-meta home-rail-meta-desk" aria-label={ui.header.sections.zh} data-aria-zh={ui.header.sections.zh} data-aria-en={ui.header.sections.en}>
      {
        railLinks.map((link) => (
          <a href={link.href}>
            <Loc zh={link.label.zh} en={link.label.en} />
            {link.favorites && <span class="fav-count" data-fav-count hidden aria-hidden="true"></span>}
          </a>
        ))
      }
    </nav>
    <details class="home-rail-more">
      <summary>
        <Loc zh={ui.nav.more.zh} en={ui.nav.more.en} />
      </summary>
      <nav class="home-rail-meta" aria-label={ui.header.sections.zh}>
        {
          railLinks.map((link) => (
            <a href={link.href}>
              <Loc zh={link.label.zh} en={link.label.en} />
              {link.favorites && <span class="fav-count" data-fav-count hidden aria-hidden="true"></span>}
            </a>
          ))
        }
      </nav>
    </details>
  </aside>

  <main class="home-plaza">
    <div class="home-plaza-scroll" data-plaza-scroll>
      <section class="plaza-hero">
        <h1><Loc zh={ui.home.heroTitle.zh} en={ui.home.heroTitle.en} /></h1>
        <p class="plaza-hero-sub">
          <Loc zh={ui.home.heroSub.zh} en={ui.home.heroSub.en} />
        </p>
        <div class="plaza-lib-row">
          {
            libraries.map((lib) => (
              <a class:list={["plaza-lib-card", lib.tone]} href={lib.href}>
                <img src={lib.image} alt="" width="168" height="112" />
                <span class="plaza-lib-copy">
                  <strong>
                    <Loc zh={lib.name.zh} en={lib.name.en} />
                  </strong>
                  <span class="plaza-lib-meta">
                    <span>
                      <span class="loc-zh">{lib.countLabel.zh}</span>
                      <span class="loc-en">{lib.countLabel.en}</span>
                    </span>
                    {
                      lib.week > 0 && (
                        <span class="plaza-week">
                          <span class="loc-zh">{lib.weekLabel.zh}</span>
                          <span class="loc-en">{lib.weekLabel.en}</span>
                        </span>
                      )
                    }
                  </span>
                </span>
              </a>
            ))
          }
        </div>
        <p class="plaza-position-also plaza-hero-also">
          <a class="plaza-also-chip" href={siblingHref} rel={sibling ? undefined : "noreferrer"}>
            <Loc zh={ui.home.siblingChip.zh} en={ui.home.siblingChip.en} />
          </a>
          <span class="plaza-position-note">
            <Loc zh={ui.home.siblingNote.zh} en={ui.home.siblingNote.en} />
          </span>
        </p>
      </section>
      <aside class="plaza-paths-strip">
        <div class="plaza-paths-copy">
          <p class="plaza-kicker"><Loc zh={ui.home.steal.zh} en={ui.home.steal.en} /></p>
          {
            steal ? (
              <h2 class="plaza-steal-title">
                <a href={withBase(`paths/${steal.slug}/`)}>
                  <span class="loc-zh">{steal.title}</span>
                  <span class="loc-en">{steal.titleEn}</span>
                </a>
              </h2>
            ) : (
              <p class="plaza-line"><Loc zh={ui.home.paths.zh} en={ui.home.paths.en} /></p>
            )
          }
          <p class="plaza-line">
            <Loc zh={stealLine.zh} en={stealLine.en} />
          </p>
          {
            also.length > 0 && (
              <p class="plaza-path-chips">
                {also.map((path) => (
                  <a href={withBase(`paths/${path.slug}/`)}>
                    <span class="loc-zh">{path.title}</span>
                    <span class="loc-en">{path.titleEn}</span>
                  </a>
                ))}
              </p>
            )
          }
        </div>
        <a class="btn btn-ghost" href={withBase("paths/")}>
          <Loc zh={ui.home.allPaths.zh} en={ui.home.allPaths.en} />
        </a>
      </aside>
      <div class="home-plaza-cols" data-plaza-grid>
        <div class="home-col" data-plaza-col>
          {col1.map((item) => <PlazaCard item={item} />)}
        </div>
        <div class="home-col" data-plaza-col>
          {col2.map((item) => <PlazaCard item={item} />)}
        </div>
        <div class="home-col" data-plaza-col>
          <DigestCard day={day} />
          {col3.map((item) => <PlazaCard item={item} />)}
        </div>
      </div>
      <p class="home-empty" hidden data-plaza-empty>
        <Loc zh={ui.home.empty.zh} en={ui.home.empty.en} />
      </p>
    </div>

    <div class="home-plaza-fade" aria-hidden="true"></div>

    <div class="home-pill" role="toolbar" aria-label={ui.home.filter.zh} data-aria-zh={ui.home.filter.zh} data-aria-en={ui.home.filter.en}>
      <button type="button" data-plaza-lib="all" aria-pressed="true">
        <Loc zh={ui.lib.all.zh} en={ui.lib.all.en} />
      </button>
      <button type="button" data-plaza-lib="grok" aria-pressed="false">Grok Bot</button>
      <button type="button" data-plaza-lib="html" aria-pressed="false">
        <Loc zh={ui.lib.html.zh} en={ui.lib.html.en} />
      </button>
      <button type="button" data-plaza-lib="agent-ui" aria-pressed="false">Agent UI</button>
    </div>
  </main>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-locale-set]").forEach((button) => {
    button.addEventListener("click", (event) => {
      event.preventDefault();
      event.stopPropagation();
      const next = button.dataset.localeSet === "en" ? "en" : "zh";
      const apply = (window as Window & { __applyLocale?: (locale: string, persist?: boolean) => void }).__applyLocale;
      apply?.(next, true);
    });
  });

  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });

  const shell = document.querySelector("[data-home-shell]");
  const buttons = shell?.querySelectorAll<HTMLButtonElement>("[data-plaza-lib]");
  const cards = shell?.querySelectorAll<HTMLElement>("[data-plaza-card]");
  const empty = shell?.querySelector<HTMLElement>("[data-plaza-empty]");
  if (shell && buttons && cards) {
    const apply = (lib: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const show = lib === "all" || card.dataset.lib === lib;
        card.hidden = !show;
        if (show) visible += 1;
      });
      buttons.forEach((button) => {
        button.setAttribute("aria-pressed", button.dataset.plazaLib === lib ? "true" : "false");
      });
      if (empty) empty.hidden = visible > 0;
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => apply(button.dataset.plazaLib ?? "all"));
    });
  }
</script>

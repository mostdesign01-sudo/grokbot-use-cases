---
import ImagePromptCard from "../../components/ImagePromptCard.astro";
import Loc from "../../components/Loc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { ui } from "../../lib/i18n";
import { listImagePrompts } from "../../lib/image-prompts";
import { withBase } from "../../lib/paths";

const listed = listImagePrompts();
---

<BaseLayout
  collection="lab"
  title={ui.imagePrompt.indexTitle.zh}
  titleEn={ui.imagePrompt.indexTitle.en}
  description={ui.imagePrompt.indexDesc.zh}
  descriptionEn={ui.imagePrompt.indexDesc.en}
>
  <div class="wrap">
    <section class="hub-intro">
      <p class="kicker"><Loc zh={ui.imagePrompt.kicker.zh} en={ui.imagePrompt.kicker.en} /></p>
      <h1><Loc zh={ui.imagePrompt.indexH1.zh} en={ui.imagePrompt.indexH1.en} /></h1>
      <p class="lede"><Loc zh={ui.imagePrompt.indexLede.zh} en={ui.imagePrompt.indexLede.en} /></p>
      <p class="combo-tease">
        <Loc zh={ui.imagePrompt.modelsTease.zh} en={ui.imagePrompt.modelsTease.en} />
        {" "}
        <a href={withBase("models/")}><Loc zh={ui.nav.models.zh} en={ui.nav.models.en} /></a>
      </p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("/")}><Loc zh={ui.footer.labHome.zh} en={ui.footer.labHome.en} /></a>
        <a class="btn btn-ghost" href={withBase("models/")}><Loc zh={ui.nav.models.zh} en={ui.nav.models.en} /></a>
        <a class="btn btn-ghost" href={withBase("changelog/")}><Loc zh={ui.nav.changelog.zh} en={ui.nav.changelog.en} /></a>
      </div>
    </section>

    <section
      class="section"
      aria-label={ui.imagePrompt.list.zh}
      data-aria-zh={ui.imagePrompt.list.zh}
      data-aria-en={ui.imagePrompt.list.en}
    >
      <div class="model-grid prompt-grid">
        {listed.map((item) => <ImagePromptCard item={item} />)}
      </div>
    </section>
  </div>
</BaseLayout>

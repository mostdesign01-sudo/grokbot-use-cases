---
import Loc from "../../../components/Loc.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getHtmlTypeCollections } from "../../../lib/html";
import { htmlTypeIntro, htmlTypeLabel } from "../../../lib/html-labels";
import { fill, ui } from "../../../lib/i18n";
import { withBase } from "../../../lib/paths";

const collections = getHtmlTypeCollections();
const lede = fill(ui.html.typesLede, { n: collections.length });
---

<BaseLayout
  collection="html"
  title={ui.html.typesTitle.zh}
  titleEn={ui.html.typesTitle.en}
  description={ui.html.typesDesc.zh}
  descriptionEn={ui.html.typesDesc.en}
>
  <div class="wrap">
    <section class="collection-hero">
      <p class="kicker">HTML Types</p>
      <h1><Loc zh={ui.html.typesH1.zh} en={ui.html.typesH1.en} /></h1>
      <p class="lede"><Loc zh={lede.zh} en={lede.en} /></p>
    </section>
    <section class="section">
      <div class="doc-grid">
        {
          collections.map((item) => {
            const count = fill(ui.poster.items, { n: item.count });
            return (
              <a class="card type-card" href={withBase(`html/types/${item.type}/`)}>
                <p class="title-en">{item.type}</p>
                <h3>
                  <span class="loc-zh">{htmlTypeLabel(item.type)}</span>
                  <span class="loc-en">{htmlTypeLabel(item.type, "en")}</span>
                </h3>
                <p class="summary">
                  <span class="loc-zh">{htmlTypeIntro(item.type)}</span>
                  <span class="loc-en">{htmlTypeIntro(item.type, "en")}</span>
                </p>
                <p class="card-meta"><Loc zh={count.zh} en={count.en} /></p>
              </a>
            );
          })
        }
      </div>
    </section>
  </div>
</BaseLayout>

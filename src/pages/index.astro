---
import AgentUiCard from "../components/AgentUiCard.astro";
import CaseCard from "../components/CaseCard.astro";
import HtmlCard from "../components/HtmlCard.astro";
import LibrarySearch from "../components/LibrarySearch.astro";
import Loc from "../components/Loc.astro";
import PosterBanners from "../components/PosterBanners.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { ui } from "../lib/i18n";
import { landingPinSearchText, getLandingPins } from "../lib/pins";
import { siteDescription, siteDescriptionEn, siteName } from "../lib/site";

const pins = getLandingPins(24);
---

<BaseLayout collection="lab" title={siteName} description={siteDescription} descriptionEn={siteDescriptionEn}>
  <div class="wrap-wide">
    <section class="landing-intro">
      <p class="kicker">{siteName}</p>
      <h1><Loc zh={ui.pages.landingH1.zh} en={ui.pages.landingH1.en} /></h1>
      <p class="lede"><Loc zh={ui.pages.landingLede.zh} en={ui.pages.landingLede.en} /></p>
    </section>

    <PosterBanners />

    <section class="section" aria-labelledby="landing-wall" data-hub>
      <div class="section-head">
        <div>
          <h2 id="landing-wall"><Loc zh={ui.pages.landingWall.zh} en={ui.pages.landingWall.en} /></h2>
          <p><Loc zh={ui.pages.landingWallLede.zh} en={ui.pages.landingWallLede.en} /></p>
        </div>
      </div>
      <LibrarySearch library="all" placeholder={ui.search.wall.zh} placeholderEn={ui.search.wall.en} />
      <div class="masonry">
        {
          pins.map((pin) => (
            <div data-filter-card data-filter-text={landingPinSearchText(pin)}>
              {pin.lib === "grok" ? (
                <CaseCard caseItem={pin.item} showLibBadge />
              ) : pin.lib === "html" ? (
                <HtmlCard item={pin.item} showLibBadge />
              ) : (
                <AgentUiCard item={pin.item} showLibBadge />
              )}
            </div>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

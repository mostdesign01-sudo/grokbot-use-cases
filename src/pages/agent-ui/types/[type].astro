---
import AgentUiCard from "../../../components/AgentUiCard.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getAgentUiByType, uniqueAgentUiTypes } from "../../../lib/agent-ui";
import { agentUiTypeIntro, agentUiTypeLabel } from "../../../lib/agent-ui-labels";
import { withBase } from "../../../lib/paths";

export function getStaticPaths() {
  return uniqueAgentUiTypes().map((type) => ({
    params: { type },
    props: { type, items: getAgentUiByType(type) },
  }));
}

const { type, items } = Astro.props;
const title = agentUiTypeLabel(type);
---

<BaseLayout collection="agent-ui" title={`${title} · AI UP LAB`} description={`${title}类型下的 ThreeUI Community 免费组件。`}>
  <div class="wrap">
    <section class="collection-hero">
      <p class="crumb">
        <a href={withBase("agent-ui/types/")}>按类型浏览</a> / {title}
      </p>
      <p class="kicker">{type}</p>
      <h1>{title}</h1>
      <p class="lede">{agentUiTypeIntro(type)} 当前 {items.length} 条。</p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("agent-ui/types/")}>全部类型</a>
        <a class="btn btn-ghost" href={withBase("agent-ui/")}>Agent UI 总览</a>
      </div>
    </section>
    <section class="section">
      <div class="grid">
        {items.map((item) => <AgentUiCard item={item} />)}
      </div>
    </section>
  </div>
</BaseLayout>

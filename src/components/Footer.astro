---
import { officialDocs } from "../lib/docs";
import { withBase } from "../lib/paths";
import { siteName, siteTagline } from "../lib/site";

const product = officialDocs.filter((item) => item.group === "product");
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <div>
      <strong>{siteName}</strong>
      <p>{siteTagline}。眼下三套库：<strong>Grok Bot</strong> 来自 <code>data/cases.json</code>；<strong>HTML 收集</strong> 来自 <code>data/html-items.json</code>；<strong>Agent UI</strong> 来自 <code>data/agent-ui.json</code>。数据分开，之后还会加更多。</p>
      <p class="disclaimer">本站为非官方整理站点，与 xAI / SpaceXAI / Cursor / ThreeUI 及所列原文站点无隶属关系。</p>
    </div>
    <div>
      <strong>Grok Bot</strong>
      <div class="footer-links">
        <a href={withBase("/")}>案例首页</a>
        <a href={withBase("featured/")}>精选案例</a>
        <a href={withBase("latest/")}>最新案例</a>
        <a href={withBase("types/")}>按类型</a>
        <a href={withBase("cases/")}>全部案例</a>
        <a href={withBase("search/")}>全库搜索</a>
        <a href={withBase("docs/")}>官方文档</a>
        <a href={withBase("changelog/")}>更新日志</a>
      </div>
    </div>
    <div>
      <strong>HTML 收集</strong>
      <div class="footer-links">
        <a href={withBase("html/")}>HTML 总览</a>
        <a href={withBase("html/featured/")}>精选 HTML</a>
        <a href={withBase("html/latest/")}>最新 HTML</a>
        <a href={withBase("html/types/")}>HTML 类型</a>
        <a href={withBase("search/?lib=html")}>搜索 HTML</a>
        <a href={withBase("html-items.json")}>HTML JSON</a>
      </div>
    </div>
    <div>
      <strong>Agent UI</strong>
      <div class="footer-links">
        <a href={withBase("agent-ui/")}>Agent UI 总览</a>
        <a href={withBase("agent-ui/featured/")}>精选</a>
        <a href={withBase("agent-ui/latest/")}>最新</a>
        <a href={withBase("agent-ui/types/")}>类型</a>
        <a href={withBase("search/?lib=agent-ui")}>搜索 Agent UI</a>
        <a href={withBase("agent-ui.json")}>Agent UI JSON</a>
        <a href="https://github.com/mostdesign01-sudo/grokbot-use-cases">GitHub 仓库</a>
      </div>
    </div>
  </div>
  <div class="wrap footer-sources">
    <strong>公开来源</strong>
    <div class="footer-links">
      {product.map((item) => <a href={item.href} rel="noreferrer">{item.title}</a>)}
      <a href="https://docs.x.ai/grok-bot/use-cases" rel="noreferrer">官方用例</a>
      <a href="https://threeui.com/browse" rel="noreferrer">ThreeUI Community</a>
      <a href="https://github.com/MengTo/threeui" rel="noreferrer">MengTo/threeui</a>
    </div>
  </div>
</footer>

---
import { withBase, isCurrentPath } from "../lib/paths";

const links = [
  { href: withBase("/"), label: "首页" },
  { href: withBase("cases/"), label: "案例" },
  { href: withBase("docs/"), label: "文档" },
  { href: withBase("changelog/"), label: "更新日志" },
];
---

<header class="site-header">
  <div class="wrap header-inner">
    <a class="brand" href={withBase("/")}>
      <span class="brand-mark">库</span>
      <span class="brand-text">
        <strong>Grok Bot 案例库</strong>
        <span>每日更新 · 非官方</span>
      </span>
    </a>
    <nav class="nav" aria-label="主导航">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isCurrentPath(Astro.url.pathname, link.href) ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换浅色或深色主题">
        <span aria-hidden="true">◐</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector("[data-theme-toggle]");
  button?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>

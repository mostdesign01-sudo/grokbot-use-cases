---
import type { AgentUiItem } from "../lib/agent-ui";
import { agentUiTypeLabel } from "../lib/agent-ui-labels";
import { withBase } from "../lib/paths";
import Badge from "./Badge.astro";
import PinVisual from "./PinVisual.astro";

interface Props {
  item: AgentUiItem;
  showLibBadge?: boolean;
}

const { item, showLibBadge = false } = Astro.props;
---

<a class="pin-card agent-ui-card pin-agent-ui" href={withBase(`agent-ui/${item.slug}/`)}>
  <PinVisual lib="agent-ui" title={item.title} seed={item.slug} image={item.previewImage} />
  <div class="pin-body">
    <div class="badges">
      {showLibBadge && <Badge kind="cursor" label="Agent UI" />}
      {item.featured && <Badge kind="featured" label="+ 精选" />}
      <Badge kind="community" label="ThreeUI" />
      {item.types.slice(0, 1).map((type) => <Badge label={agentUiTypeLabel(type)} />)}
    </div>
    <h3>{item.title}</h3>
    <p class="pin-reveal summary">{item.summary}</p>
    <div class="card-meta">
      <span>{item.tags.slice(0, 2).join(" · ")}</span>
    </div>
  </div>
</a>

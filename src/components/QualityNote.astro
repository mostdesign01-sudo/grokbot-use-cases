---
import Loc from "./Loc.astro";
import { ui } from "../lib/i18n";

interface Props {
  note?: string;
  noteEn?: string;
}

const { note, noteEn = note } = Astro.props;
---

{
  note ? (
    <p class="quality-note">
      <span class="quality-label"><Loc zh={ui.quality.zh} en={ui.quality.en} /></span>
      <span class="loc-zh">{note}</span>
      <span class="loc-en">{noteEn}</span>
    </p>
  ) : null
}

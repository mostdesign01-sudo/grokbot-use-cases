---
interface Props {
  kind?:
    | "official"
    | "community"
    | "cursor"
    | "approval"
    | "routine"
    | "multi"
    | "featured"
    | "difficulty"
    | "plain"
    | string;
  label: string;
  labelEn?: string;
}

const { kind = "plain", label, labelEn = label } = Astro.props;
---

<span class:list={["badge", kind]}>
  <span class="loc-zh">{label}</span>
  <span class="loc-en">{labelEn}</span>
</span>

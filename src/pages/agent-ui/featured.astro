---
import AgentUiCard from "../../components/AgentUiCard.astro";
import Loc from "../../components/Loc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getFeaturedAgentUi } from "../../lib/agent-ui";
import { fill, ui } from "../../lib/i18n";
import { withBase } from "../../lib/paths";

const featured = getFeaturedAgentUi();
const lede = fill(ui.agent.featuredLede, { n: featured.length });
---

<BaseLayout
  collection="agent-ui"
  title={ui.agent.featuredTitle.zh}
  titleEn={ui.agent.featuredTitle.en}
  description={ui.agent.featuredDesc.zh}
  descriptionEn={ui.agent.featuredDesc.en}
>
  <div class="wrap-wide">
    <section class="collection-hero">
      <p class="kicker">Featured Agent UI</p>
      <h1><Loc zh={ui.agent.featuredH1.zh} en={ui.agent.featuredH1.en} /></h1>
      <p class="lede"><Loc zh={lede.zh} en={lede.en} /></p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("agent-ui/latest/")}><Loc zh={ui.nav.latest.zh} en={ui.nav.latest.en} /></a>
        <a class="btn btn-ghost" href={withBase("agent-ui/types/")}><Loc zh={ui.footer.byType.zh} en={ui.footer.byType.en} /></a>
      </div>
    </section>
    <section class="section">
      <div class="masonry">
        {featured.map((item) => <AgentUiCard item={item} />)}
      </div>
    </section>
  </div>
</BaseLayout>

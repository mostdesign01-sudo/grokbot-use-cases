---
import type { HtmlItem } from "../lib/html";
import { htmlTypeLabel } from "../lib/html-labels";
import { withBase } from "../lib/paths";
import Badge from "./Badge.astro";
import PinVisual from "./PinVisual.astro";

interface Props {
  item: HtmlItem;
  showLibBadge?: boolean;
}

const { item, showLibBadge = false } = Astro.props;
---

<a class="pin-card html-card pin-html" href={withBase(`html/${item.slug}/`)}>
  <PinVisual lib="html" title={item.title} seed={item.slug} image={item.previewImage} />
  <div class="pin-body">
    <div class="badges">
      {showLibBadge && <Badge kind="official" label="HTML 收集" />}
      {item.featured && <Badge kind="featured" label="+ 精选" />}
      {item.types.slice(0, 2).map((type) => <Badge label={htmlTypeLabel(type)} />)}
    </div>
    <h3>{item.title}</h3>
    <p class="pin-reveal summary">{item.summary}</p>
    <div class="card-meta">
      <span>{item.tags.slice(0, 2).join(" · ")}</span>
    </div>
  </div>
</a>

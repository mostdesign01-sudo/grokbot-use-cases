---
import Badge from "../../components/Badge.astro";
import CaseCard from "../../components/CaseCard.astro";
import FavButton from "../../components/FavButton.astro";
import Loc from "../../components/Loc.astro";
import ModelCard from "../../components/ModelCard.astro";
import Stars from "../../components/Stars.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatPublishedDate, formatShanghaiDateTime } from "../../lib/format";
import { ui } from "../../lib/i18n";
import {
  getOfficialSources,
  getRelatedCasesForModel,
  getRelatedModels,
  getShowcaseSources,
  listModels,
  models,
} from "../../lib/models";
import { assetUrl, withBase } from "../../lib/paths";

export function getStaticPaths() {
  return models.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const official = getOfficialSources(item);
const showcase = getShowcaseSources(item);
const hasCommunity = showcase.some((source) => source.kind === "community");
const relatedCases = getRelatedCasesForModel(item);
const relatedModels = getRelatedModels(item);
const highlights = item.highlights ?? [];
const preview = assetUrl(item.previewImage);

const kindLabel = (kind: string) =>
  kind === "official" ? ui.model.official : kind === "community" ? ui.model.showcase : ui.model.product;
const kindBadge = (kind: string) => (kind === "official" ? "official" : kind === "community" ? "community" : "plain");
---

<BaseLayout
  collection="lab"
  title={`${item.title} · AI UP LAB`}
  titleEn={`${item.titleEn} · AI UP LAB`}
  description={item.summary}
  descriptionEn={item.summaryEn}
>
  <div class="wrap">
    <article class="detail-hero">
      <p class="crumb">
        <a href={withBase("/")}><Loc zh={ui.detail.lab.zh} en={ui.detail.lab.en} /></a> /
        <a href={withBase("models/")}><Loc zh={ui.nav.models.zh} en={ui.nav.models.en} /></a> /
        <span class="loc-zh">{item.title}</span>
        <span class="loc-en">{item.titleEn}</span>
      </p>
      <div class="badges">
        <Badge kind="approval" label={item.vendor} />
        {official.length > 0 && <Badge kind="official" label={ui.badge.official.zh} labelEn={ui.badge.official.en} />}
        {hasCommunity && <Badge kind="community" label={ui.model.showcase.zh} labelEn={ui.model.showcase.en} />}
        {item.featured && <Badge kind="featured" label={ui.badge.featured.zh} labelEn={ui.badge.featured.en} />}
        <Stars value={item.stars} />
      </div>
      <h1>
        <span class="loc-zh">{item.title}</span>
        <span class="loc-en">{item.titleEn}</span>
      </h1>
      <p class="title-en loc-zh">{item.titleEn}</p>
      <p class="lede">
        <span class="loc-zh">{item.summary}</span>
        <span class="loc-en">{item.summaryEn}</span>
      </p>
      <div class="hero-actions">
        <FavButton lib="models" id={item.id} variant="button" />
      </div>
      {
        preview && (
          <figure class="detail-preview model-preview">
            <img src={preview} alt="" />
            {(item.previewCredit || item.previewCreditEn) && (
              <figcaption>
                <span class="loc-zh">{item.previewCredit ?? item.previewCreditEn}</span>
                <span class="loc-en">{item.previewCreditEn ?? item.previewCredit}</span>
              </figcaption>
            )}
          </figure>
        )
      }
    </article>

    <div class="detail-grid">
      <div>
        <section class="panel">
          <h2><Loc zh={ui.model.sources.zh} en={ui.model.sources.en} /></h2>
          <div class="model-sources">
            {
              item.sources.map((source) => (
                <a class="model-source" href={source.url} rel="noreferrer">
                  <span class="model-source-kind">
                    <Badge
                      kind={kindBadge(source.kind)}
                      label={kindLabel(source.kind).zh}
                      labelEn={kindLabel(source.kind).en}
                    />
                  </span>
                  <strong>
                    <span class="loc-zh">{source.label}</span>
                    <span class="loc-en">{source.labelEn}</span>
                  </strong>
                  <span class="model-source-meta">
                    {source.by && <span>{source.by}</span>}
                    {source.date && (
                      <span>
                        <span class="loc-zh">{formatPublishedDate(source.date)}</span>
                        <span class="loc-en">{formatPublishedDate(source.date, "en-US")}</span>
                      </span>
                    )}
                    <span class="model-source-url">{source.url}</span>
                  </span>
                </a>
              ))
            }
          </div>
          <p class="quality-note">
            <strong><Loc zh={ui.quality.zh} en={ui.quality.en} /></strong>
            <span class="loc-zh">{item.qualityNote}</span>
            <span class="loc-en">{item.qualityNoteEn}</span>
          </p>
        </section>

        {
          highlights.length > 0 && (
            <section class="panel">
              <h2><Loc zh={ui.model.highlights.zh} en={ui.model.highlights.en} /></h2>
              <ul class="model-highlights">
                {highlights.map((point) => (
                  <li>
                    <span class="loc-zh">{point.text}</span>
                    <span class="loc-en">{point.textEn}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          relatedModels.length > 0 && (
            <section class="section">
              <h2><Loc zh={ui.model.relatedModels.zh} en={ui.model.relatedModels.en} /></h2>
              <p class="combo-tease"><Loc zh={ui.model.relatedModelsHint.zh} en={ui.model.relatedModelsHint.en} /></p>
              <div class="model-grid model-grid-related">
                {relatedModels.map((relatedItem) => (
                  <ModelCard model={relatedItem} />
                ))}
              </div>
            </section>
          )
        }

        {
          relatedCases.length > 0 && (
            <section class="section">
              <h2><Loc zh={ui.model.relatedCase.zh} en={ui.model.relatedCase.en} /></h2>
              <p class="combo-tease"><Loc zh={ui.model.relatedCaseHint.zh} en={ui.model.relatedCaseHint.en} /></p>
              <div class="tweet-feed tweet-feed-related">
                {relatedCases.map((relatedItem) => (
                  <CaseCard caseItem={relatedItem} />
                ))}
              </div>
            </section>
          )
        }
      </div>

      <aside>
        <section class="panel">
          <h2><Loc zh={ui.detail.metadata.zh} en={ui.detail.metadata.en} /></h2>
          <dl class="kv">
            <div>
              <dt><Loc zh={ui.model.vendor.zh} en={ui.model.vendor.en} /></dt>
              <dd>{item.vendor}</dd>
            </div>
            <div>
              <dt><Loc zh={ui.model.announced.zh} en={ui.model.announced.en} /></dt>
              <dd>
                <span class="loc-zh">{formatPublishedDate(item.announcedAt)}</span>
                <span class="loc-en">{formatPublishedDate(item.announcedAt, "en-US")}</span>
              </dd>
            </div>
            <div>
              <dt><Loc zh={ui.model.listed.zh} en={ui.model.listed.en} /></dt>
              <dd>
                <span class="loc-zh">{formatPublishedDate(item.publishedAt)}</span>
                <span class="loc-en">{formatPublishedDate(item.publishedAt, "en-US")}</span>
              </dd>
            </div>
            <div>
              <dt><Loc zh={ui.meta.itemUpdated.zh} en={ui.meta.itemUpdated.en} /></dt>
              <dd>
                <span class="loc-zh">{formatShanghaiDateTime(item.updatedAt)}</span>
                <span class="loc-en">{formatShanghaiDateTime(item.updatedAt, "en-US")}</span>
              </dd>
            </div>
            {
              item.stars && (
                <div>
                  <dt><Loc zh={ui.stars.label.zh} en={ui.stars.label.en} /></dt>
                  <dd class="kv-stars">
                    <Stars value={item.stars} />
                    <span class="kv-hint"><Loc zh={ui.stars.hint.zh} en={ui.stars.hint.en} /></span>
                  </dd>
                </div>
              )
            }
            <div>
              <dt><Loc zh={ui.model.sourceCount.zh} en={ui.model.sourceCount.en} /></dt>
              <dd>
                <span class="loc-zh">{`${official.length} 官方 · ${showcase.length} 社区 / 产品`}</span>
                <span class="loc-en">{`${official.length} official · ${showcase.length} community / product`}</span>
              </dd>
            </div>
            {
              (item.previewCredit || item.previewCreditEn) && (
                <div>
                  <dt><Loc zh={ui.model.previewCredit.zh} en={ui.model.previewCredit.en} /></dt>
                  <dd>
                    <span class="loc-zh">{item.previewCredit ?? item.previewCreditEn}</span>
                    <span class="loc-en">{item.previewCreditEn ?? item.previewCredit}</span>
                  </dd>
                </div>
              )
            }
          </dl>
        </section>
        <section class="panel">
          <h2><Loc zh={ui.meta.publicSources.zh} en={ui.meta.publicSources.en} /></h2>
          <div class="source-list">
            {item.sources.map((source) => (
              <a href={source.url} rel="noreferrer">
                {source.url}
              </a>
            ))}
          </div>
        </section>
        {
          models.length > 1 && (
            <section class="panel">
              <h2><Loc zh={ui.model.otherModels.zh} en={ui.model.otherModels.en} /></h2>
              <div class="source-list">
                {listModels()
                  .filter((other) => other.id !== item.id)
                  .map((other) => (
                    <a href={withBase(`models/${other.slug}/`)}>
                      <span class="loc-zh">{other.title}</span>
                      <span class="loc-en">{other.titleEn}</span>
                    </a>
                  ))}
              </div>
            </section>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>

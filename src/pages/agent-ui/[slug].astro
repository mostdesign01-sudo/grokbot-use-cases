---
import AgentUiCard from "../../components/AgentUiCard.astro";
import Badge from "../../components/Badge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { agentUiItems, RESERVED_AGENT_UI_SLUGS } from "../../lib/agent-ui";
import { agentUiTypeIntro, agentUiTypeLabel } from "../../lib/agent-ui-labels";
import { formatPublishedDate, formatShanghaiDateTime } from "../../lib/format";
import { withBase } from "../../lib/paths";

export function getStaticPaths() {
  return agentUiItems
    .filter((item) => !RESERVED_AGENT_UI_SLUGS.has(item.slug))
    .map((item) => ({
      params: { slug: item.slug },
      props: { item },
    }));
}

const { item } = Astro.props;
const related = agentUiItems
  .filter((other) => other.id !== item.id && other.types.some((type) => item.types.includes(type)))
  .slice(0, 3);
const sources = [item.sourceUrl, ...(item.secondaryUrls ?? [])];
---

<BaseLayout collection="agent-ui" title={`${item.title} · AI UP LAB`} description={item.summary}>
  <div class="wrap">
    <article class="detail-hero">
      <p class="crumb">
        <a href={withBase("agent-ui/")}>Agent UI</a> / {item.title}
      </p>
      <div class="badges">
        {item.featured && <Badge kind="official" label="精选" />}
        <Badge kind="community" label="ThreeUI Community" />
        {item.types.map((type) => <Badge label={agentUiTypeLabel(type)} />)}
      </div>
      <h1>{item.title}</h1>
      <p class="lede">{item.summary}</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href={item.sourceUrl} rel="noreferrer">打开原文</a>
        <a class="btn btn-ghost" href={withBase("agent-ui/types/")}>按类型</a>
      </div>
    </article>

    <div class="detail-grid">
      <div>
        <section class="panel">
          <h2>适合怎么用</h2>
          <ul class="learn-list">
            {
              item.types.map((type) => (
                <li>
                  <strong>{agentUiTypeLabel(type)}</strong>
                  <p>{agentUiTypeIntro(type)}</p>
                </li>
              ))
            }
          </ul>
          <p class="quality-note">
            <strong>收录理由</strong>
            {item.qualityNote}
          </p>
          {
            item.promptHint && (
              <p class="quality-note">
                <strong>给 Agent</strong>
                {item.promptHint}
              </p>
            )
          }
        </section>
        {
          related.length > 0 && (
            <section class="section">
              <h2>同类型</h2>
              <div class="masonry masonry-related">
                {related.map((other) => (
                  <AgentUiCard item={other} />
                ))}
              </div>
            </section>
          )
        }
      </div>
      <aside>
        <section class="panel">
          <h2>元信息</h2>
          <dl class="kv">
            <div>
              <dt>类型</dt>
              <dd class="chips">
                {item.types.map((type) => (
                  <a class="chip" href={withBase(`agent-ui/types/${type}/`)}>
                    {agentUiTypeLabel(type)}
                  </a>
                ))}
              </dd>
            </div>
            <div>
              <dt>标签</dt>
              <dd>{item.tags.join(" · ")}</dd>
            </div>
            {
              item.npmPackage && (
                <div>
                  <dt>npm</dt>
                  <dd><code>{item.npmPackage}</code></dd>
                </div>
              )
            }
            <div>
              <dt>公开约</dt>
              <dd>{formatPublishedDate(item.publishedAt)}</dd>
            </div>
            <div>
              <dt>本库校对</dt>
              <dd>{formatShanghaiDateTime(item.updatedAt)}</dd>
            </div>
          </dl>
        </section>
        <section class="panel">
          <h2>公开来源</h2>
          <div class="source-list">
            {sources.map((href) => (
              <a href={href} rel="noreferrer">
                {href}
              </a>
            ))}
          </div>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

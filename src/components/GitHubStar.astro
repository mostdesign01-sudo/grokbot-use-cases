---
import Loc from "./Loc.astro";
import { ui } from "../lib/i18n";
import { repoApiUrl, repoSlug, repoUrl } from "../lib/site";

/**
 * "Star this project on GitHub" CTA for the site's own repo.
 * Not the curator ★ rating (`stars` in JSON) and not the visitor ☆ favorites
 * (localStorage) — those stay untouched. The live stargazer count is painted
 * client-side from the public GitHub API and simply stays hidden if that fails.
 */
interface Props {
  variant?: "pill" | "rail" | "line";
}

const { variant = "pill" } = Astro.props;

const GITHUB_MARK =
  "M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z";
---

{
  variant === "rail" ? (
    <a class="gh-star gh-star-rail" href={repoUrl} rel="noreferrer" data-gh-star>
      <span class="gh-star-head">
        <svg class="gh-mark" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
          <path d={GITHUB_MARK} />
        </svg>
        <strong><Loc zh={ui.github.cta.zh} en={ui.github.cta.en} /></strong>
        <span class="gh-star-badge" aria-hidden="true">
          <span class="gh-star-glyph">★</span>
          <span class="gh-star-count" data-gh-stars hidden></span>
        </span>
      </span>
      <span class="gh-star-repo">GitHub · {repoSlug}</span>
    </a>
  ) : variant === "line" ? (
    <p class="gh-star-line">
      <a class="gh-star" href={repoUrl} rel="noreferrer" data-gh-star>
        <span class="gh-star-glyph" aria-hidden="true">★</span>
        <Loc zh={ui.github.footer.zh} en={ui.github.footer.en} />
        <span aria-hidden="true">→</span>
      </a>
    </p>
  ) : (
    <a
      class="gh-star gh-star-pill"
      href={repoUrl}
      rel="noreferrer"
      data-gh-star
      aria-label={ui.github.title.zh}
      data-aria-zh={ui.github.title.zh}
      data-aria-en={ui.github.title.en}
    >
      <svg class="gh-mark" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
        <path d={GITHUB_MARK} />
      </svg>
      <span class="gh-star-label"><Loc zh={ui.github.star.zh} en={ui.github.star.en} /></span>
      <span class="gh-star-count" data-gh-stars hidden aria-hidden="true"></span>
    </a>
  )
}

<script>
  import { repoApiUrl } from "../lib/site";

  // Live stargazer count. Public, unauthenticated, CORS-enabled; cached per
  // browser for an hour so the 60 req/h anonymous limit is never a concern.
  // Any failure (offline, rate-limited, blocked) leaves the count hidden.
  const KEY = "aiuplab:gh-stars";
  const TTL = 60 * 60 * 1000;
  const targets = document.querySelectorAll<HTMLElement>("[data-gh-stars]");

  const paint = (count: number) => {
    if (!Number.isInteger(count) || count <= 0) return;
    const text = new Intl.NumberFormat("en", { notation: "compact", maximumFractionDigits: 1 }).format(count);
    targets.forEach((el) => {
      el.textContent = text;
      el.hidden = false;
    });
  };

  const readCache = (): number | null => {
    try {
      const parsed: unknown = JSON.parse(localStorage.getItem(KEY) ?? "null");
      if (
        parsed &&
        typeof parsed === "object" &&
        typeof (parsed as { count?: unknown }).count === "number" &&
        typeof (parsed as { at?: unknown }).at === "number" &&
        Date.now() - (parsed as { at: number }).at < TTL
      ) {
        return (parsed as { count: number }).count;
      }
    } catch {
      /* ignore */
    }
    return null;
  };

  if (targets.length > 0) {
    const cached = readCache();
    if (cached !== null) {
      paint(cached);
    } else {
      fetch(repoApiUrl, { headers: { Accept: "application/vnd.github+json" } })
        .then((res) => (res.ok ? res.json() : null))
        .then((json: { stargazers_count?: unknown } | null) => {
          const count = json && typeof json.stargazers_count === "number" ? json.stargazers_count : null;
          if (count === null) return;
          try {
            localStorage.setItem(KEY, JSON.stringify({ count, at: Date.now() }));
          } catch {
            /* private mode / quota */
          }
          paint(count);
        })
        .catch(() => {});
    }
  }
</script>

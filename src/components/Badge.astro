---
interface Props {
  kind?:
    | "official"
    | "community"
    | "cursor"
    | "approval"
    | "routine"
    | "multi"
    | "featured"
    | "difficulty"
    | "plain"
    | string;
  label: string;
}

const { kind = "plain", label } = Astro.props;
---

<span class:list={["badge", kind]}>{label}</span>

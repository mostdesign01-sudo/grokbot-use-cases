---
import CaseCard from "../components/CaseCard.astro";
import Loc from "../components/Loc.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLatestCases } from "../lib/cases";
import { ui } from "../lib/i18n";
import { withBase } from "../lib/paths";

const latest = getLatestCases();
---

<BaseLayout
  collection="grok"
  title={ui.grok.latestTitle.zh}
  titleEn={ui.grok.latestTitle.en}
  description={ui.grok.latestDesc.zh}
  descriptionEn={ui.grok.latestDesc.en}
>
  <div class="wrap-wide">
    <section class="collection-hero">
      <p class="kicker">Latest</p>
      <h1><Loc zh={ui.grok.latestH1.zh} en={ui.grok.latestH1.en} /></h1>
      <p class="lede">
        <span class="loc-zh">
          按 <code>publishedAt</code> 再按 <code>updatedAt</code> 从新到旧排列，便于先看最近公开的用法。当前共 {latest.length} 条。
        </span>
        <span class="loc-en">
          Sorted by <code>publishedAt</code>, then <code>updatedAt</code>, newest first. {latest.length} now.
        </span>
      </p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("featured/")}><Loc zh={ui.grok.viewFeatured.zh} en={ui.grok.viewFeatured.en} /></a>
        <a class="btn btn-ghost" href={withBase("types/")}><Loc zh={ui.grok.browseTypes.zh} en={ui.grok.browseTypes.en} /></a>
        <a class="btn btn-ghost" href={withBase("cases/")}><Loc zh={ui.grok.allCases.zh} en={ui.grok.allCases.en} /></a>
      </div>
    </section>

    <section class="section" aria-label={ui.grok.latestList.zh} data-aria-zh={ui.grok.latestList.zh} data-aria-en={ui.grok.latestList.en}>
      <div class="masonry">
        {latest.map((item) => <CaseCard caseItem={item} />)}
      </div>
    </section>
  </div>
</BaseLayout>

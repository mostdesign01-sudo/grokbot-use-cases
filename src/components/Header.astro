---
import { withBase, isCurrentPath, isSectionPath } from "../lib/paths";
import { siteName } from "../lib/site";

const path = Astro.url.pathname;
const htmlRoot = withBase("html/");
const agentUiRoot = withBase("agent-ui/");
const isHtml = isSectionPath(path, htmlRoot);
const isAgentUi = isSectionPath(path, agentUiRoot);
const currentLib = isAgentUi ? "agent-ui" : isHtml ? "html" : "grok";

const grokLinks = [
  { href: withBase("/"), label: "首页" },
  { href: withBase("featured/"), label: "精选" },
  { href: withBase("latest/"), label: "最新" },
  { href: withBase("types/"), label: "类型", section: true },
  { href: withBase("cases/"), label: "案例" },
  { href: withBase("search/"), label: "搜索" },
  { href: withBase("docs/"), label: "文档" },
  { href: withBase("changelog/"), label: "更新日志" },
];

const htmlLinks = [
  { href: withBase("html/"), label: "总览" },
  { href: withBase("html/featured/"), label: "精选" },
  { href: withBase("html/latest/"), label: "最新" },
  { href: withBase("html/types/"), label: "类型", section: true },
  { href: withBase("search/?lib=html"), label: "搜索" },
];

const agentUiLinks = [
  { href: withBase("agent-ui/"), label: "总览" },
  { href: withBase("agent-ui/featured/"), label: "精选" },
  { href: withBase("agent-ui/latest/"), label: "最新" },
  { href: withBase("agent-ui/types/"), label: "类型", section: true },
  { href: withBase("search/?lib=agent-ui"), label: "搜索" },
];

const links = currentLib === "agent-ui" ? agentUiLinks : currentLib === "html" ? htmlLinks : grokLinks;

const brandLine =
  currentLib === "agent-ui" ? "Agent UI · 每日更新" : currentLib === "html" ? "HTML 收集 · 每日更新" : "Grok Bot · 每日更新";
---

<header class="site-header">
  <div class="wrap header-inner">
    <div class="header-start">
      <a class="brand" href={withBase("/")}>
        <span class="brand-mark" aria-hidden="true">
          <span class="brand-mark-letters">AI</span>
          <span class="brand-mark-dots"><i></i><i></i><i></i></span>
        </span>
        <span class="brand-text">
          <strong>{siteName}</strong>
          <span>{brandLine}</span>
        </span>
      </a>
      <nav class="collection-tabs" aria-label="内容库">
        <a
          class="tab-grok"
          href={withBase("/")}
          aria-current={currentLib === "grok" ? "page" : undefined}
        >
          Grok Bot
        </a>
        <a
          class="tab-html"
          href={withBase("html/")}
          aria-current={currentLib === "html" ? "page" : undefined}
        >
          HTML 收集
        </a>
        <a
          class="tab-agent-ui"
          href={withBase("agent-ui/")}
          aria-current={currentLib === "agent-ui" ? "page" : undefined}
        >
          Agent UI
        </a>
      </nav>
    </div>
    <nav class="nav" aria-label="栏目">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={(link.section
              ? isSectionPath(path, link.href)
              : isCurrentPath(path, link.href))
              ? "page"
              : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切换浅色或深色主题">
        <span aria-hidden="true">◐</span>
      </button>
    </nav>
  </div>
</header>

<script>
  const button = document.querySelector("[data-theme-toggle]");
  button?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("theme", next);
  });
</script>

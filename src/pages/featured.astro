---
import CaseCard from "../components/CaseCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getFeaturedCases } from "../lib/cases";
import { withBase } from "../lib/paths";

const featured = getFeaturedCases();
---

<BaseLayout title="精选案例 · AI UP LAB" description="编辑精选的 Grok Bot 用法，适合作为第一个 Bot 或团队协作模板。">
  <div class="wrap">
    <section class="collection-hero">
      <p class="kicker">Featured</p>
      <h1>精选案例</h1>
      <p class="lede">
        从 <code>data/cases.json</code> 中 <code>featured === true</code> 的条目整理而来，适合对照官方角色、例行与审批边界，作为第一个 Bot 或团队协作模板。当前 {featured.length} 条。
      </p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("latest/")}>查看最新</a>
        <a class="btn btn-ghost" href={withBase("types/")}>按类型浏览</a>
        <a class="btn btn-ghost" href={withBase("cases/")}>全部案例</a>
      </div>
    </section>

    <section class="section" aria-label="精选案例列表">
      <div class="grid">
        {featured.map((item) => <CaseCard caseItem={item} />)}
      </div>
    </section>
  </div>
</BaseLayout>

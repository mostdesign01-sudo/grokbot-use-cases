---
import { pinRatio, type PinLib } from "../lib/pins";

interface Props {
  lib: PinLib;
  title: string;
  seed: string;
  image?: string;
}

const { lib, title, seed, image } = Astro.props;
const ratio = pinRatio(seed);
---

<div class:list={["pin-visual", `pin-${lib}`, `pin-ratio-${ratio}`]} aria-hidden="true">
  {
    image ? (
      <img src={image} alt="" loading="lazy" />
    ) : (
      <div class:list={["pin-art", `pin-pattern-${ratio}`]}>
        <span class="pin-art-title">{title}</span>
      </div>
    )
  }
</div>

---
import HtmlCard from "../../components/HtmlCard.astro";
import Loc from "../../components/Loc.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLatestHtml } from "../../lib/html";
import { ui } from "../../lib/i18n";
import { withBase } from "../../lib/paths";

const latest = getLatestHtml();
---

<BaseLayout
  collection="html"
  title={ui.html.latestTitle.zh}
  titleEn={ui.html.latestTitle.en}
  description={ui.html.latestDesc.zh}
  descriptionEn={ui.html.latestDesc.en}
>
  <div class="wrap-wide">
    <section class="collection-hero">
      <p class="kicker">Latest HTML</p>
      <h1><Loc zh={ui.html.latestH1.zh} en={ui.html.latestH1.en} /></h1>
      <p class="lede">
        <span class="loc-zh">
          按 <code>publishedAt</code> 再按 <code>updatedAt</code> 从新到旧。当前 {latest.length} 条。
        </span>
        <span class="loc-en">
          Sorted by <code>publishedAt</code>, then <code>updatedAt</code>, newest first. {latest.length} now.
        </span>
      </p>
      <div class="hero-actions">
        <a class="btn btn-ghost" href={withBase("html/featured/")}><Loc zh={ui.html.featuredHtml.zh} en={ui.html.featuredHtml.en} /></a>
        <a class="btn btn-ghost" href={withBase("html/types/")}><Loc zh={ui.footer.byType.zh} en={ui.footer.byType.en} /></a>
      </div>
    </section>
    <section class="section">
      <div class="masonry">
        {latest.map((item) => <HtmlCard item={item} />)}
      </div>
    </section>
  </div>
</BaseLayout>
